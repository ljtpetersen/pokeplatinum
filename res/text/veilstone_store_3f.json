  "key": 9235,
  "messages": [
    {
      "id": "VeilstoneStore3F_Text_MayIHelpYou",
      "en_US": [
        "Hello.\n",
        "May I help you with anything?"
      ],
      "fr_FR": [
        "Bonjour.\n",
        "Je peux vous renseigner?"
      ]
    },
    {
      "id": "VeilstoneStore3F_Text_PlayerMayIHelpYou",
      "en_US": [
        "Hello, {STRVAR_1 3, 0, 0}.\n",
        "May I help you with anything?"
      ],
      "fr_FR": [
        "Bonjour, {STRVAR_1 3, 0, 0}.\n",
        "Je peux vous aider?"
      ]
    },
    {
      "id": "VeilstoneStore3F_Text_PleaseEnjoyYourself",
      "en_US": "Please enjoy yourself.",
      "fr_FR": "Faites comme chez vous."
    },
    {
      "id": "VeilstoneStore3F_Text_FalseSwipeMakesCatchingEasier",
      "en_US": [
        "False Swipe makes wild Pokémon easier\n",
        "to catch.\r",
        "Many customers have confided that to\n",
        "me recently."
      ],
      "fr_FR": [
        "Faux-Chage permet d’attraper plus \n",
        "facilement les Pokémon sauvages.\r",
        "C’est ce que m’ont confié de nombreux\n",
        "clients ces derniers temps."
      ]
    },
    {
      "id": "VeilstoneStore3F_Text_FireBlastForFireTypes",
      "en_US": [
        "For Fire-type Pokémon, may I suggest\n",
        "Fire Blast?"
      ],
      "fr_FR": [
        "Puis-je suggérer Déflagration\n",
        "pour les Pokémon de type Feu?"
      ]
    },
    {
      "id": "VeilstoneStore3F_Text_ProtectForDodgingAttacks",
      "en_US": [
        "The move Protect is the perfect\n",
        "solution for dodging attacks.\r",
        "Please be aware that overuse can\n",
        "result in failure."
      ],
      "fr_FR": [
        "La capacité Abri est la solution\n",
        "idéale pour esquiver les attaques.\r",
        "N’oubliez pas, plus vous l’utilisez et\n",
        "plus elle a de chances d’échouer."
      ]
    },
    {
      "id": "VeilstoneStore3F_Text_ThunderIsPreciseInRain",
      "en_US": [
        "When it is raining, the accuracy\n",
        "of Thunder becomes precise.\r",
        "Please do be careful about\n",
        "the weather."
      ],
      "fr_FR": [
        "La précision de Fatal-Foudre augmente\n",
        "par temps de pluie.\r",
        "S’il vous plaît, gardez un œil \n",
        "sur la météo."
      ]
    },
    {
      "id": "VeilstoneStore3F_Text_FriendTradedMeMachoke",
      "en_US": [
        "A friend traded me a MACHOKE using\n",
        "DS Wireless Communications.\r",
        "But instead of a MACHOKE, I got\n",
        "a different Pokémon!"
      ],
      "fr_FR": [
        "Un ami a voulu m’échanger un MACHOPEUR\n",
        "avec la communication sans fil DS.\r",
        "Bizarrement, je n’ai pas reçu un\n",
        "MACHOPEUR mais un autre Pokémon!"
      ]
    },
    {
      "id": "VeilstoneStore3F_Text_WroteSecretsInMyMail",
      "en_US": [
        "I wrote some secrets in my Mail\n",
        "as a reminder...\r",
        "If someone reads it...\n",
        "I’m in deep trouble."
      ],
      "fr_FR": [
        "J’ai noté des secrets dans une\n",
        "Lettre pour ne pas les oublier...\r",
        "Si quelqu’un la lit...\n",
        "Je suis dans de beaux draps."
      ]
    },
    {
      "id": "VeilstoneStore3F_Text_WantToBuyAllMerchandise",
      "en_US": [
        "I would love to buy up all the\n",
        "merchandise here.\r",
        "Even once would do!"
      ],
      "fr_FR": [
        "J’ai une folle envie de tout acheter.\r",
        "Juste une fois, ça suffirait!"
      ]
    },
    {
      "id": "VeilstoneStore3F_Text_Directory",
      "en_US": [
        "B1F: Food & Produce\r",
        "1F: Trainers’ Zone\r",
        "2F: Battle Collection\r",
        "3F: TM Corner\r",
        "4F: Poké Dolls & Goods\r",
        "5F: Rooftop Plaza"
      ],
      "fr_FR": [
        "-1: Alimentation\r",
        "RC: Espace Dresseurs\r",
        "1¹: Fournitures de Combat\r",
        "2⁴: Centre CT\r",
        "3⁴: Poupées Pokémon et articles\r",
        "4⁴: Terrasse"
      ]
    }
  ]
}