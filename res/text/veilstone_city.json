    {
      "id": "VeilstoneCity_Text_DawnPleaseCanYouHelpMe",
      "en_US": [
        "Dawn: Hi, {STRVAR_1 3, 0, 0}!\n",
        "Please, can you help me?\r",
        "Some Team Galactic goons took my\n",
        "Pokédex away from me.\r",
        "I need your help to get it back.\r",
        "I’ll be waiting in front of the\n",
        "warehouses. Please come!\r"
      ],
      "fr_FR": [
        "Aurore: Salut, {STRVAR_1 3, 0, 0}!\n",
        "Tu peux m’aider?\r",
        "Ces bandits de la Team Galaxie m’ont\n",
        "volé mon Pokédex.\r",
        "Aide-moi à le récupérer, s’il te plaît.\r",
        "Je t’attendrai devant le hangar!\n",
        "A tout de suite!\r"
      ]
    },
