{
  "key": 9262,
  "messages": [
    {
      "id": "TwinleafTownSouthwestHouse_Text_PokemonProfessorReturned",
      "en_US": [
        "Did you hear?\r",
        "The Pokémon Professor returned\n",
        "to the next town over.\r",
        "They say he was gone for four long\n",
        "years.\r",
        "I wonder if he found some amazing\n",
        "Pokémon while he was gone?"
      ],
      "fr_FR": [
        "Tu es au courant?\r",
        "Le Professeur Pokémon est revenu dans\n",
        "la ville voisine.\r",
        "On dit qu’il est resté absent quatre\n",
        "longues années.\r",
        "Je me demande s’il a découvert des\n",
        "Pokémon incroyables pendant ce temps."
      ]
    },
    {
      "id": "TwinleafTownSouthwestHouse_Text_ProfRowanGavePokedex",
      "en_US": [
        "Well! Professor Rowan gave you a\n",
        "Pokédex, did he?"
      ],
      "fr_FR": [
        "Bien! Le Professeur Sorbier t’a donné\n",
        "un Pokédex, n’est-ce pas?"
      ]
    },
    {
      "id": "TwinleafTownSouthwestHouse_Text_IWantACutePokemon",
      "en_US": [
        "Listen, listen, {STRVAR_1 3, 0, 0}.\n",
        "I want a cute Pokémon!"
      ],
      "fr_FR": [
        "Ecoute, {STRVAR_1 3, 0, 0}.\n",
        "Je veux un Pokémon gracieux!"
      ]
    },
    {
      "id": "TwinleafTownSouthwestHouse_Text_CanIBeFriendsWithPokemon",
      "en_US": [
        "Listen, listen, {STRVAR_1 3, 0, 0}.\r",
        "Do you think I can be friends with\n",
        "Pokémon like you are?"
      ],
      "fr_FR": [
        "Dis-moi, {STRVAR_1 3, 0, 0}.\r",
        "Crois-tu que je puisse devenir amie avec\n",
        "les Pokémon, comme toi?"
      ]
    }
  ]
}