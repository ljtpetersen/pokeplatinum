  "messages": [
    {
      "id": "PokemonCenter2FCommon_Text_WelcomeToColosseum",
      "en_US": [
        "Welcome to the Pokémon Communication\n",
        "Club Colosseum.\r",
        "You may battle with your friends\n",
        "here.\r"
      ],
      "fr_FR": [
        "Bienvenue au Colisée du Club Link\n",
        "Pokémon.\r",
        "Vous pouvez affronter vos amis ici.\r"
      ]
    },
    {
      "id": "PokemonCenter2FCommon_Text_WhichBattleMode",
      "en_US": [
        "Which Battle Mode would you like\n",
        "to play?"
      ],
      "fr_FR": "Quel mode de combat choisissez-vous?"
    },
    {
      "id": "PokemonCenter2FCommon_Text_BattleModesInfo",
      "en_US": [
        "There are four Battle Modes.\r",
        "Single Battle is for two Trainers\n",
        "with one or more Pokémon each.\r",
        "Each Trainer can have one Pokémon\n",
        "in battle at a time.\r",
        "Double Battle is for two Trainers\n",
        "with two or more Pokémon each.\r",
        "Each Trainer will send out two\n",
        "Pokémon to battle at a time.\r",
        "Mix Battle is for two Trainers\n",
        "with three Pokémon each.\r",
        "Each Trainer chooses one of the\n",
        "opponent’s Pokémon, mixes them\r",
        "with their own party, and then\n",
        "battles the other Trainer.\r",
        "Multi Battle is for four Trainers\n",
        "with one or more Pokémon each.\r",
        "Each Trainer can have one Pokémon\n",
        "in battle at a time.\r"
      ],
      "fr_FR": [
        "Il existe quatre modes de combat.\r",
        "Les Combats Solo sont pour deux\n",
        "Dresseurs et un ou plusieurs\f",
        "Pokémon chacun.\r",
        "Chaque Dresseur n’a qu’un seul\n",
        "Pokémon au combat à la fois.\r",
        "Les Combats Duo sont pour deux\n",
        "Dresseurs et deux Pokémon ou\f",
        "plus chacun.\r",
        "Chaque Dresseur a deux Pokémon\n",
        "au combat en même temps.\r",
        "Les Combats Mixtes sont pour deux\n",
        "Dresseurs et trois Pokémon chacun.\r",
        "Chaque Dresseur choisit un des\n",
        "Pokémon de l’adversaire, le met dans\f",
        "son équipe, puis combat.\r",
        "Les Combats Multi sont pour quatre\n",
        "Dresseurs et trois Pokémon ou plus\f",
        "chacun.\r",
        "Chaque Dresseur n’a qu’un seul\n",
        "Pokémon au combat à la fois.\r"
      ]
    },
