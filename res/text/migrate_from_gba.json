    },
    {
      "id": "MigrateFromGBA_Text_FullDayHasntPassed",
      "en_US": [
        "Pokémon may migrate from a Game Boy\n",
        "Advance Game Pak only once a day.\r",
        "A full day hasn’t passed since\n",
        "Pokémon migrated from this Game Pak."
      ],
      "fr_FR": [
        "Les Pokémon ne peuvent être importés\n",
        "qu’une fois par jour et par cartouche.\r",
        "Des Pokémon ont déjà migré de cette\n",
        "cartouche de jeu il y a moins de 24h."
      ]
    },
    {
      "id": "MigrateFromGBA_Text_DifferentDsOrInternalClockAltered",
      "en_US": [
        "You are using a different Nintendo DS,\n",
        "or its internal clock has been altered.\r",
        "If the game’s time setting is changed,\n",
        "you will not be able to migrate\f",
        "Pokémon for another 24 hours.\r",
        "Would you like to change your game’s\n",
        "time setting to match the Nintendo DS?"
      ],
      "fr_FR": [
        "Vous avez modifié l’horloge interne ou\n",
        "utilisez une Nintendo DS différente.\r",
        "Les migrations de Pokémon sont\n",
        "suspendues pendant 24h lorsque\f",
        "vous modifiez l’heure.\r",
        "Voulez-vous aligner l’heure du jeu sur\n",
        "l’horloge interne de votre Nintendo DS?"
      ]
    },
    {
      "id": "MigrateFromGBA_Text_GameClockAdjusted",
      "en_US": [
        "The game clock has been adjusted.\r",
        "Pokémon cannot be made to migrate\n",
        "for 24 hours."
      ],
      "fr_FR": [
        "L’horloge du jeu a été modifiée.\r",
        "Aucun Pokémon ne pourra être importé\n",
        "pendant 24h."
      ]
    },
    {
