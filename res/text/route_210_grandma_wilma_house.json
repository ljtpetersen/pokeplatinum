    {
      "id": "Route210GrandmaWilmaHouse_Text_ExplainDracoMeteor",
      "en_US": [
        "Draco Meteor’s destructive power\n",
        "is awe inspiring.\r",
        "However, using it will also lower\n",
        "the Pokémon’s Special Attack."
      ],
      "fr_FR": [
        "La puissance destructrice de Draco\n",
        "Météor est terrifiante.\r",
        "Mais son emploi réduit également\n",
        "l’Attaque Spéciale du Pokémon."
      ]
    }
  ]
