{
  "key": 17423,
  "messages": [
    {
      "id": "JubilifeTV4F_Text_YourExploitsAreFantastic",
      "en_US": [
        "Your exploits are fantastic!\r",
        "With our TV station, we can tell\n",
        "the whole world about you!\r",
        "It’s merely one of many possibilities!\n",
        "Harrumph!"
      ],
      "fr_FR": [
        "Tes exploits sont incroyables!\r",
        "Grâce à notre chaîne de télé, on peut\n",
        "parler de toi au monde entier!\r",
        "Ce n’est que l’une de nos nombreuses\n",
        "possibilités!"
      ]
    },
    {
      "id": "JubilifeTV4F_Text_TVNetworksMotto",
      "en_US": [
        "“Participation for all” is our TV\n",
        "network’s motto."
      ],
      "fr_FR": [
        "“Tout le monde participe” est le slogan\n",
        "de notre réseau télé."
      ]
    },
    {
      "id": "JubilifeTV4F_Text_ThemeSmilesAreDreamy",
      "en_US": [
        "We’re promoting the theme “Smiles are\n",
        "dreamy.”\r",
        "In keeping with that theme, we added\n",
        "variety programs to our scheduling.\r",
        "Please do tune in!"
      ],
      "fr_FR": [
        "Dans le cadre de notre campagne “Un\n",
        "sourire, ça fait plaisir!”, nous avons\r",
        "ajouté de nouvelles émissions de\n",
        "variétés à nos programmes.\r",
        "Merci de votre fidélité!"
      ]
    }
  ]
}