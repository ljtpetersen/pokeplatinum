{
  "key": 53290,
  "messages": [
    {
      "id": "PokemonLeagueHallOfFame_Text_BeenAWhileSinceIEnteredThisRoom",
      "en_US": [
        "Rowan: It’s been a long while since\n",
        "I last entered this room...\r"
      ],
      "fr_FR": [
        "Sorbier: La dernière fois que je suis \n",
        "venu ici remonte à bien longtemps...\r"
      ]
    },
    {
      "id": "PokemonLeagueHallOfFame_Text_AlwaysStraighterThanUsual",
      "en_US": [
        "Rowan: No matter how many times\n",
        "I come here, I always find myself\f",
        "standing up straighter than usual.\r"
      ],
      "fr_FR": [
        "Sorbier: A chaque fois que je \n",
        "pénètre en ce lieu, je ne peux\f",
        "m’empêcher d’être solennel.\r"
      ]
    },
    {
      "id": "PokemonLeagueHallOfFame_Text_LastTimeWasLongTimeAgo",
      "en_US": [
        "Cynthia: If your last time here was\n",
        "when I became Champion, then yes,\f",
        "that would be quite a long time ago.\r"
      ],
      "fr_FR": [
        "Cynthia: Si la dernière fois remonte\n",
        "à mon couronnement, en effet,\f",
        "ça fait un bon bout de temps.\r"
      ]
    },
    {
      "id": "PokemonLeagueHallOfFame_Text_LegacyToPokemonAndTrainers",
      "en_US": [
        "Cynthia: It’s a natural reaction,\n",
        "Professor.\r",
        "This room is a legacy to the hopes,\n",
        "dreams, and struggles of Pokémon\f",
        "and their Trainers to excel.\r"
      ],
      "fr_FR": [
        "Cynthia: C’est une réaction \n",
        "naturelle, professeur.\r",
        "Cette salle est un sanctuaire à la \n",
        "gloire des espoirs et des rêves des\f",
        "Dresseurs et de leurs Pokémon.\r"
      ]
    },
    {
      "id": "PokemonLeagueHallOfFame_Text_WelcomeToTheHallOfFameMale",
      "en_US": [
        "Cynthia: {STRVAR_1 3, 0, 0}, welcome\n",
        "to the Hall of Fame.\r"
      ],
      "fr_FR": [
        "Cynthia: {STRVAR_1 3, 0, 0}, bienvenue au \n",
        "Panthéon des Dresseurs.\r"
      ]
    },
    {
      "id": "PokemonLeagueHallOfFame_Text_WelcomeToTheHallOfFameFemale",
      "en_US": [
        "Cynthia: {STRVAR_1 3, 0, 0}, welcome\n",
        "to the Hall of Fame.\r"
      ],
      "fr_FR": [
        "Cynthia: {STRVAR_1 3, 0, 0}, bienvenue au \n",
        "Panthéon des Dresseurs.\r"
      ]
    },
    {
      "id": "PokemonLeagueHallOfFame_Text_RecordYourNameAndPokemon",
      "en_US": [
        "Your names will be recorded for\n",
        "posterity here.\r",
        "What you are leaving are the memories\n",
        "of your adventure so far.\r",
        "It’s time to record your names.\n",
        "You and your Pokémon.\r",
        "Remember, your Pokémon are partners\n",
        "that grew with you through\f",
        "many challenging battles.\r",
        "This machine will make a permanent\n",
        "record of your achievement.\r"
      ],
      "fr_FR": [
        "Ton nom et ceux de tes Pokémon \n",
        "seront inscrits ici à jamais.\r",
        "Les souvenirs de tes aventures \n",
        "resteront gravés ici.\r",
        "Rappelle-toi que tes Pokémon sont tes \n",
        "partenaires, qu’ils grandissent avec\f",
        "toi, à travers toutes les épreuves.\r",
        "Cette machine va enregistrer \n",
        "vos prouesses pour l’éternité.\r"
      ]
    }
  ]
}