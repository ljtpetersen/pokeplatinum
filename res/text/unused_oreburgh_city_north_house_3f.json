    {
      "id": "OreburghCityNorthHouse3F_Text_EveryoneGoesToTheMine",
      "en_US": [
        "During the daytime, everyone goes off\n",
        "to the mine.\r",
        "At night, everyone’s at home\n",
        "getting some well-deserved rest."
      ],
      "fr_FR": [
        "Pendant la journée, tout le monde va\n",
        "à la mine.\r",
        "La nuit, tout le monde rentre prendre\n",
        "un repos bien mérité."
      ]
    },
    {
      "id": "OreburghCityNorthHouse3F_Text_WellKeepDiggingCoal",
      "en_US": [
        "We’ll keep digging coal.\n",
        "The world needs energy!"
      ],
      "fr_FR": [
        "On creuse pour trouver du charbon.\n",
        "Le monde a besoin d’énergie!"
      ]
    },
    {
      "id": "OreburghCityNorthHouse3F_Text_EveryoneDugUndergroundMaze",
      "en_US": [
        "Everyone, including lots of Pokémon,\n",
        "dug the big underground maze!"
      ],
      "fr_FR": [
        "Tout le monde creuse le grand\n",
        "labyrinthe souterrain, y compris des\f",
        "tas de Pokémon!"
      ]
    }
  ]
