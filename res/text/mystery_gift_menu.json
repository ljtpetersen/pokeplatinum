    {
      "id": "MysteryGiftMenu_Text_GiftBeingSharedByAnotherPerson",
      "en_US": [
        "This gift is being shared by\n",
        "another person.\r",
        "You may accept this gift, but you\n",
        "will not be able to distribute it\f",
        "to your friends.\r",
        "Will you accept this gift?"
