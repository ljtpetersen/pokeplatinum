    {
      "id": "pl_msg_00000358_00009",
      "en_US": [
        "Are you in a location where you can\n",
        "connect to Nintendo Wi-Fi Connection?"
      ],
      "fr_FR": [
        "Pouvez-vous vous connecter à la\n",
        "connexion Wi-Fi Nintendo?"
      ]
    },
    {
      "id": "pl_msg_00000358_00010",
      "en_US": [
        "Please register when you can connect\n",
        "to Nintendo Wi-Fi Connection.\r"
      ],
      "fr_FR": [
        "Pour enregistrer un code Wii, vous\n",
        "devez avoir accès à la CWF Nintendo.\r"
      ]
    },
    {
      "id": "pl_msg_00000358_00011",
      "en_US": [
        "Your Wii number and this Nintendo DS\n",
        "system’s Nintendo WFC User Information\f",
        "will be saved.\r",
        "Connect to Nintendo Wi-Fi Connection?"
      ],
      "fr_FR": [
        "Le code Wii et les paramètres de la\n",
        "configuration CWF Nintendo de cette\r",
        "console Nintendo DS vont\n",
        "être sauvegardés.\r",
        "Se connecter à la CWF Nintendo?"
      ]
    },
    {
      "id": "pl_msg_00000358_00012",
      "en_US": [
        "Unable to connect to Nintendo Wi-Fi\n",
        "Connection.\r",
        "Please check your connection settings."
      ],
      "fr_FR": [
        "Impossible de se connecter à la\n",
        "connexion Wi-Fi Nintendo.\r",
        "Vérifiez les paramètres de la\n",
        "connexion."
      ]
    },
    {
      "id": "pl_msg_00000358_00013",
      "en_US": [
        "The Registration Code has been sent to\n",
        "your Wii console.\r",
        "Please enter the Registration Code."
      ],
      "fr_FR": [
        "Un code d’inscription a été envoyé\n",
        "sur votre console Wii.\r",
        "Veuillez saisir ce code d’inscription."
      ]
    },
    {
      "id": "pl_msg_00000358_00014",
      "en_US": [
        "Disconnect from Nintendo WFC and\n",
        "cancel registering your Wii number?"
      ],
      "fr_FR": [
        "Se déconnecter de la CWF Nintendo et\n",
        "annuler l’enregistrement du code Wii?"
      ]
    },
    {
      "id": "pl_msg_00000358_00015",
      "en_US": [
        "Disconnecting from Nintendo Wi-Fi\n",
        "Connection. Please wait..."
      ],
      "fr_FR": [
        "Déconnexion de la connexion \n",
        "Wi-Fi Nintendo. Veuillez patienter..."
      ]
    },
    {
      "id": "pl_msg_00000358_00016",
      "en_US": [
        "You are now disconnected from Nintendo\n",
        "Wi-Fi Connection."
      ],
      "fr_FR": [
        "Vous avez été déconnecté de \n",
        "la connexion Wi-Fi Nintendo."
      ]
    },
    {
      "id": "pl_msg_00000358_00017",
      "en_US": [
        "Please enter the last four digits of\n",
        "the Registration Code from the\f",
        "Wii message.\r"
      ],
      "fr_FR": [
        "Veuillez saisir les quatre derniers\n",
        "chiffres du code d’inscription\f",
        "qui vous a été communiqué par\f",
        "message Wii.\r"
      ]
    },
    {
      "id": "pl_msg_00000358_00018",
      "en_US": [
        "Confirming the Registration Code.\n",
        "Please wait..."
      ],
      "fr_FR": [
        "Confirmation du code d’inscription.\n",
        "Veuillez patienter..."
      ]
    },
    {
      "id": "pl_msg_00000358_00019",
      "en_US": "Incorrect Registration Code.\r",
      "fr_FR": "Code d’inscription incorrect.\r"
    },
    {
      "id": "pl_msg_00000358_00020",
      "en_US": "Your Wii number has been registered.\r",
      "fr_FR": [
        "Votre code Wii est maintenant\n",
        "enregistré.\r"
      ]
    },
    {
      "id": "pl_msg_00000358_00021",
      "en_US": [
        "A password is needed to confirm your\n",
        "Wii number.\r",
        "Please enter a 4-digit number and make\n",
        "note of it as your Wii number password.\r"
      ],
      "fr_FR": [
        "Un mot de passe est requis pour\n",
        "confirmer votre code Wii.\r",
        "Veuillez saisir un nombre à quatre\n",
        "chiffres et en prendre note.\r",
        "Ce nombre constituera le mot de passe\n",
        "lié à votre code Wii.\r"
      ]
    },
    {
      "id": "pl_msg_00000358_00022",
      "garbage": 21
    },
    {
      "id": "pl_msg_00000358_00023",
      "garbage": 34
    },
    {
      "id": "pl_msg_00000358_00024",
      "en_US": "Your Wii number password has been set.\r",
      "fr_FR": [
        "Le mot de passe lié à votre code Wii\n",
        "est enregistré.\r"
      ]
    },
    {
      "id": "pl_msg_00000358_00025",
      "en_US": [
        "You may choose to receive a\n",
        "Wii message when a trade\f",
        "goes through at the GTS.\r",
        "Would you like to be notified\n",
        "by a Wii message?"
      ],
      "fr_FR": [
        "Vous pouvez choisir de recevoir un\n",
        "message Wii lorsqu’un échange\f",
        "est conclu à la GTS.\r",
        "Voulez-vous activer la notification\n",
        "par message Wii?"
      ]
    },
    {
      "id": "pl_msg_00000358_00026",
      "en_US": [
        "You have chosen to receive\n",
        "Wii messages.\r",
        "The next time you use the GTS, you will\n",
        "be notified of trades by Wii messages.\r"
      ],
      "fr_FR": [
        "Vous avez choisi de recevoir les\n",
        "messages Wii de confirmation.\r",
        "Quand vous utiliserez la GTS, tout\n",
        "échange sera confirmé par message Wii.\r"
      ]
    },
    {
      "id": "pl_msg_00000358_00027",
      "en_US": [
        "You have chosen not to receive\n",
        "Wii messages.\r",
        "The next time you use the GTS,\n",
        "you will not be notified of trades by\f",
        "Wii messages.\r"
      ],
      "fr_FR": [
        "Vous avez choisi de ne pas recevoir\n",
        "les messages Wii de confirmation.\r",
        "Quand vous utiliserez la GTS, les\n",
        "échanges ne seront donc pas confirmés\f",
        "par message Wii.\r"
      ]
    },
    {
      "id": "pl_msg_00000358_00028",
      "en_US": [
        "Your Wii message settings and the\n",
        "password will be deleted. Is that OK?"
      ],
      "fr_FR": [
        "Les paramètres des messages Wii et\n",
        "le mot de passe lié à votre code Wii\f",
        "seront effacés. Confirmer?"
      ]
    },
    {
      "id": "pl_msg_00000358_00029",
      "en_US": "All Wii message settings were deleted.\r",
      "fr_FR": [
        "Les paramètres des messages Wii ont\n",
        "été effacés.\r"
      ]
    },
