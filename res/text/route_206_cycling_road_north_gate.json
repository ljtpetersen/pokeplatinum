    {
      "id": "Route206CyclingRoadNorthGate_Text_SomethingForYou",
      "en_US": [
        "Oh, my!\n",
        "You’ve met {STRVAR_1 52, 1, 0} Pokémon!\r",
        "Wonderful! Yes, bravo!\n",
        "Professor Rowan should be delighted!\r",
        "Here is something for you!\r"
      ],
      "fr_FR": [
        "Nom d’une pipe!\n",
        "Tu as rencontré {STRVAR_1 52, 1, 0} Pokémon!\r",
        "Merveilleux! Je te tire mon chapeau!\n",
        "Le Professeur Sorbier sera ravi!\r",
        "Voilà ta récompense!\r"
      ]
    },
    {
      "id": "Route206CyclingRoadNorthGate_Text_HoldingExpShareGetExpPoints",
      "en_US": [
        "A Pokémon holding an Exp. Share will get\n",
        "some of the Exp. Points from battle.\r",
        "It will get Exp. Points even if it didn’t\n",
        "actually battle.\r",
        "Therefore, it should be held by a\n",
        "Pokémon you want to raise quickly.\r",
        "Also, a Pokémon you get in a trade may\n",
        "disobey you if it is too high in level.\r",
        "Don’t worry, though. It will obey if\n",
        "you have enough Gym Badges."
      ],
      "fr_FR": [
        "Un Pokémon tenant Multi Exp recevra\n",
        "une partie des Points Exp. obtenus\f",
        "à la fin du combat.\r",
        "Cela fonctionne même quand il\n",
        "n’y participe pas.\r",
        "Donne-le à un Pokémon que tu veux faire\n",
        "grandir rapidement.\r",
        "Au fait, il arrive qu’un Pokémon obtenu\n",
        "lors d’un échange refuse d’obéir quand\f",
        "son niveau est trop élevé.\r",
        "Mais ne t’inquiète pas. Il t’obéira\n",
        "quand tu auras assez de Badges."
      ]
    },
    {
      "id": "Route206CyclingRoadNorthGate_Text_FindAtLeast35",
      "en_US": [
        "You’ve met only {STRVAR_1 52, 1, 0} Pokémon?\r",
        "Hmm...\n",
        "You’ve got to find at least 35.\r",
        "If you can’t, it will be tough to\n",
        "complete the Sinnoh Pokédex."
      ],
      "fr_FR": [
        "Tu n’as croisé que {STRVAR_1 52, 1, 0} Pokémon?\r",
        "Hum...\n",
        "Tu dois en trouver au moins 35.\r",
        "Tu auras du mal à compléter le Pokédex\n",
        "de Sinnoh si tu n’y arrives pas."
      ]
    }
