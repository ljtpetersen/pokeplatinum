    {
      "id": "Route206CyclingRoadNorthGate_Text_OnlyForBicycles",
      "en_US": [
        "Cycling Road is only for Bicycles!\r",
        "Please get on your Bicycle!\r"
      ],
      "fr_FR": [
        "La Piste Cyclable est interdite aux\n",
        "piétons!\r",
        "En selle, camarade!\r"
      ]
    },
    {
      "id": "Route206CyclingRoadNorthGate_Text_LearnHowToShiftGears",
      "en_US": [
        "Learn how to shift gears, and you’ll\n",
        "be able to ride anywhere."
      ],
      "fr_FR": [
        "Apprenez à passer les vitesses et\n",
        "vous pourrez aller n’importe où."
      ]
    },
    {
      "id": "Route206CyclingRoadNorthGate_Text_PlayerMetHowManyPokemon",
      "en_US": [
        "{STRVAR_1 3, 0, 0}, long time, no see!\r",
        "Oh? You look puzzled.\n",
        "You’re wondering who I am.\r",
        "I’m Professor Rowan’s assistant and\n",
        "{STRVAR_1 3, 1, 0}’s father.\r",
        "I’ve come a long way to help you on\n",
        "your adventure at the professor’s\f",
        "behest.\r",
        "{STRVAR_1 3, 0, 0}, let me ask you,\n",
        "how many Pokémon have you met?\r"
      ],
      "fr_FR": [
        "{STRVAR_1 3, 0, 0}, ça faisait longtemps!\r",
        "Oh? Quelque chose te chiffonne?\n",
        "Tu te demandes qui je suis.\r",
        "Je suis l’assistant du Professeur\n",
        "Sorbier. Tu connais {STRVAR_1 3, 1, 0}?\f",
        "Je suis son père.\r",
        "J’ai parcouru un long chemin pour\n",
        "t’aider dans ton aventure sur ordre\f",
        "du professeur.\r",
        "{STRVAR_1 3, 0, 0}, laisse-moi te poser une\n",
        "question, combien as-tu vu de Pokémon?\r"
      ]
    },
