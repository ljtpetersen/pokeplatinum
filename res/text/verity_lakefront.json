      "en_US": [
        "{STRVAR_1 3, 0, 0}: All right!\n",
        "We’re at the lake!\r",
        "Get ready, because we’re capturing\n",
        "that legendary Pokémon.\r",
        "Trust me on this one. It’s here.\n",
        "It even says so on the sign!\r"
