  "key": 29268,
  "messages": [
    {
      "id": "Route205House_Text_RestAWhile",
      "en_US": [
        "You seem to be tired...\n",
        "Rest a while."
      ],
      "fr_FR": [
        "Tu as l’air raplapla.\n",
        "Tu devrais peut-être te reposer."
      ]
    },
    {
      "id": "Route205House_Text_PokemonLookRefreshed",
      "en_US": [
        "You and your Pokémon look\n",
        "completely refreshed!"
      ],
      "fr_FR": [
        "Eh bien, toi et ton équipe Pokémon avez\n",
        "l’air d’aller mieux."
      ]
    },
    {
      "id": "Route205House_Text_DontPushYourself",
      "en_US": [
        "Just because you’re young doesn’t\n",
        "mean you should push yourself."
      ],
      "fr_FR": [
        "Ce n’est pas parce que tu es jeune que\n",
        "tu dois abuser de tes forces!"
      ]
    },
    {
      "id": "Route205House_Text_RepelsAreUseful",
      "en_US": [
        "Repels are useful, don’t you think?\r",
        "When you use a Repel, weak Pokémon\n",
        "won’t come out.\r",
        "...But that also means there won’t be\n",
        "any Pokémon to capture."
      ],
      "fr_FR": [
        "L’objet Repousse est très utile!\r",
        "Il permet de faire fuir les Pokémon\n",
        "faibles.\r",
        "Cela veut aussi dire qu’il y a beaucoup\n",
        "moins de Pokémon à capturer..."
      ]
    }
  ]
}