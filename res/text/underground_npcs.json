  "messages": [
    {
      "id": "UndergroundNPCs_Text_IllTradeYouSomething",
      "en_US": [
        "You’ve got a Sphere or two?\n",
        "If you do, I’ll trade you something."
      ],
      "fr_FR": [
        "Moi, les Sphères, c’est mon dada...\n",
        "Je suis prêt à tout pour en récupérer.\r",
        "Mais si tu n’en as pas, je rachète aussi\n",
        "les objets dont tu n’as plus besoin."
      ]
    },
    {
      "id": "UndergroundNPCs_Text_PickSpherePrompt",
      "en_US": [
        "Which Sphere will you trade me for\n",
        "my {STRVAR_1 25, 2, 0}?"
      ],
      "fr_FR": [
        "Quelle Sphère voudrais-tu échanger\n",
        "contre mon objet {STRVAR_1 25, 2, 0}?"
      ]
    },
    {
      "id": "UndergroundNPCs_Text_LetsDoThisTrade",
      "en_US": [
        "All right!\n",
        "Let’s do this trade!"
      ],
      "fr_FR": [
        "D’accord!\n",
        "Marché conclu!"
      ]
    },
    {
      "id": "UndergroundNPCs_Text_YouDontHaveRoom",
      "en_US": [
        "Oh, now wait a second!\n",
        "You don’t have any room for this!"
      ],
      "fr_FR": [
        "Hé, attends une seconde!\n",
        "Tu n’as pas de place pour ça!"
      ]
    },
    {
      "id": "UndergroundNPCs_Text_WrongKindOfSphere",
      "en_US": "That’s not the right kind of Sphere!",
      "fr_FR": "Ce n’est pas le bon type de Sphère!"
    },
    {
      "id": "UndergroundNPCs_Text_SphereTooSmall",
