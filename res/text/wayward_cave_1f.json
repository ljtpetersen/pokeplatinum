{
  "key": 42051,
  "messages": [
    {
      "id": "WaywardCave1F_Text_PleaseTakeMeToTheExit",
      "en_US": [
        "I’m Mira...\r",
        "I was catching Pokémon, and then\n",
        "I got lost...\r",
        "I’m so scared...\r",
        "Please!\n",
        "Please take me to the exit!\r"
      ],
      "fr_FR": [
        "Je m’appelle Maïté...\r",
        "Je me suis perdue en\n",
        "pourchassant des Pokémon...\r",
        "J’ai si peur...\r",
        "S’il te plaît!\n",
        "S’il te plaît, fais-moi sortir d’ici!\r"
      ]
    },
    {
      "id": "WaywardCave1F_Text_PlayerDecidedToGoWithMira",
      "en_US": [
        "{STRVAR_1 3, 0, 0} decided to go with\n",
        "Mira!"
      ],
      "fr_FR": [
        "{STRVAR_1 3, 0, 0} décide d’accompagner\n",
        "Maïté!"
      ]
    },
    {
      "id": "WaywardCave1F_Text_IllKeepYourPokemonHealthy",
      "en_US": [
        "Mira: I’ll keep your Pokémon healthy\n",
        "all the time!"
      ],
      "fr_FR": [
        "Maïté: Quoi qu’il arrive, je garderai tes\n",
        "Pokémon en bonne santé!"
      ]
    },
    {
      "id": "WaywardCave1F_Text_ILikeYourName",
      "en_US": [
        "Trainer, your name is {STRVAR_1 3, 0, 0}?\r",
        "My name is Mira.\n",
        "I like your name!\r"
      ],
      "fr_FR": [
        "Alors tu t’appelles {STRVAR_1 3, 0, 0}?\r",
        "Moi c’est Maïté.\n",
        "J’aime bien ton nom!\r"
      ]
    },
    {
      "id": "WaywardCave1F_Text_OhPlayerIWaitedALongTime",
      "en_US": [
        "Mira: Oh! {STRVAR_1 3, 0, 0}...\n",
        "I waited... A long time...\r"
      ],
      "fr_FR": [
        "Maïté: Oh! {STRVAR_1 3, 0, 0}...\n",
        "J’ai attendu... si longtemps...\r"
      ]
    },
    {
      "id": "WaywardCave1F_Text_TheresTheExit",
      "en_US": [
        "Mira: Oh! There’s the exit!\r",
        "I want to get tougher so I\n",
        "won’t be such a scaredy-cat.\r",
        "{STRVAR_1 3, 0, 0}, bye-bye!\n",
        "Thank you!\r"
      ],
      "fr_FR": [
        "Maïté: Oh! Voilà la sortie!\r",
        "Je dois m’endurcir, j’en ai marre\n",
        "d’être une poule mouillée.\r",
        "A la prochaine, {STRVAR_1 3, 0, 0}!\n",
        "Merci encore!\r"
      ]
    },
    {
      "id": "WaywardCave1F_Text_Dummy6",
      "garbage": 29
    },
    {
      "id": "WaywardCave1F_Text_Dummy7",
      "garbage": 29
    },
    {
      "id": "WaywardCave1F_Text_Dummy8",
      "garbage": 26
    },
    {
      "id": "WaywardCave1F_Text_ILikeHelpfulMoves",
      "en_US": [
        "Mira: I like helpful Pokémon moves\n",
        "like Growl and Minimize.\r",
        "Those kinds of moves are my\n",
        "favorites."
      ],
      "fr_FR": [
        "Maïté: J’aime bien les capacités utiles\n",
        "comme Rugissement et Lilliput.\r",
        "Ce sont mes capacités préférées."
      ]
    },
    {
      "id": "WaywardCave1F_Text_EasyToGetConfused",
      "en_US": [
        "Mira: This cave...\n",
        "It’s so easy to get confused.\r",
        "Do you know where we are?"
      ],
      "fr_FR": [
        "Maïté: Cette grotte... C’est un vrai \n",
        "labyrinthe. Tu sais où on est?"
      ]
    },
    {
      "id": "WaywardCave1F_Text_MiraWillTryLikeYou",
      "en_US": [
        "Mira: {STRVAR_1 3, 0, 0}, did you get to be\n",
        "so good because you’re always with\f",
        "your Pokémon?\r",
        "Yes! That has to be it!\n",
        "Mira will try like you!"
      ],
      "fr_FR": [
        "Maïté: {STRVAR_1 3, 0, 0}, comment fais-tu\n",
        "pour progresser, tu ne quittes\f",
        "jamais tes Pokémon?\r",
        "Mais oui! C’est ça!\n",
        "Je vais suivre ton exemple!"
      ]
    }
  ]
}