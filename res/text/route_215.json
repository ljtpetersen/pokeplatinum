    {
      "id": "Route215_Text_TrainerTipsPhysicalSpecial",
      "en_US": [
        "Trainer Tips\r",
        "Pokémon attacks are classified as\n",
        "being either physical or special.\r",
        "A physical attack is based on the\n",
        "Attack stat of the Pokémon.\r",
        "Likewise, a special attack is based\n",
        "on the Special Attack stat."
      ],
      "fr_FR": [
        "Conseils aux Dresseurs\r",
        "Les attaques Pokémon sont classées en\n",
        "deux types: physiques et spéciales.\r",
        "Une attaque physique repose sur la\n",
        "stat d’Attaque du Pokémon.\r",
        "Une attaque spéciale repose sur sa\n",
        "stat d’Attaque Spéciale."
      ]
    }
  ]
}