{
  "key": 21176,
  "messages": [
    {
      "id": "PokemonMansionMaidsRoom_Text_PutThisOnPokemon",
      "en_US": [
        "You know how you can catch Pokémon\n",
        "in the trophy garden?\r",
        "If you put this on a caught Pokémon,\n",
        "it warms up to you faster.\r",
        "I’ll share one with you, so give it\n",
        "a try.\r"
      ],
      "fr_FR": [
        "Tu sais que tu peux attraper des\n",
        "Pokémon sauvages dans le jardin?\r",
        "Si tu fais tenir ceci à un Pokémon,\n",
        "il s’habituera à toi plus rapidement.\r",
        "Je t’en donne un pour que tu\n",
        "l’essaies.\r"
      ]
    },
    {
      "id": "PokemonMansionMaidsRoom_Text_TrainerThatPokemonLove",
      "en_US": [
        "I hope you become a Trainer that\n",
        "Pokémon can love and trust."
      ],
      "fr_FR": [
        "J’espère que tu deviendras un Dresseur\n",
        "très apprécié des Pokémon."
      ]
    },
    {
      "id": "PokemonMansionMaidsRoom_Text_ImNotLoafing",
      "en_US": [
        "I’m not loafing.\n",
        "I’m just taking a personal break.\r",
        "It’s my official policy to sleep in a bed\n",
        "when I’m officially loafing."
      ],
      "fr_FR": [
        "Je ne suis pas en train de buller.\n",
        "Je fais une pause réparatrice.\r",
        "Et pour cela, rien de mieux qu’un\n",
        "lit bien douillet."
      ]
    },
    {
      "id": "PokemonMansionMaidsRoom_Text_WantToRest",
      "en_US": [
        "It’s a bed...\n",
        "Want to take a rest?"
      ],
      "fr_FR": [
        "C’est un lit...\n",
        "Faire une sieste?"
      ]
    },
    {
      "id": "PokemonMansionMaidsRoom_Text_PlayerFellAsleep",
      "en_US": [
        "{STRVAR_1 3, 0, 0} quickly fell asleep in\n",
        "the bed...\r"
      ],
      "fr_FR": [
        "{STRVAR_1 3, 0, 0} sombre dans un profond\n",
        "sommeil...\r"
      ]
    },
    {
      "id": "PokemonMansionMaidsRoom_Text_PokemonFullyHealed",
      "en_US": [
        "{STRVAR_1 3, 0, 0} and the Pokémon became\n",
        "fully healed from the nap!"
      ],
      "fr_FR": [
        "{STRVAR_1 3, 0, 0} et son équipe ressortent\n",
        "de leur sieste en pleine forme!"
      ]
    }
  ]
}