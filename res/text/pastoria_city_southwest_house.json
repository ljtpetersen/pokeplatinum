  "key": 13339,
  "messages": [
    {
      "id": "PastoriaCitySouthwestHouse_Text_PlantThisBerry",
      "en_US": [
        "I’ve been hiking all around the\n",
        "Sinnoh region.\r",
        "I love planting Berries wherever\n",
        "I go.\r",
        "I’ll give you a Berry, too.\n",
        "Please plant it somewhere.\r"
      ],
      "fr_FR": [
        "Je traverse la région de\n",
        "Sinnoh en randonnée.\r",
        "J’adore planter des Baies\n",
        "partout où je vais.\r",
        "Tiens, je te fais cadeau d’une Baie.\n",
        "Plante-la quelque part.\r"
      ]
    },
    {
      "id": "PastoriaCitySouthwestHouse_Text_PlantingIsGood",
      "en_US": [
        "Planting Berries is good for Pokémon.\r",
        "It provides them with more things to\n",
        "eat in the wild."
      ],
      "fr_FR": [
        "Planter des Baies, c’est bon pour\n",
        "les Pokémon.\r",
        "Ça aide à nourrir les Pokémon sauvages."
      ]
    },
    {
      "id": "PastoriaCitySouthwestHouse_Text_SisterGathersBerries",
      "en_US": [
        "My sister gathers Berries every day!\n",
        "Please come visit again!\r",
        "We cook the Berries, too!\n",
        "We mix them up! They’re yummy!"
      ],
      "fr_FR": [
        "Ma sœur ramasse des Baies tous les\n",
        "jours! Reviens quand tu veux!\r",
        "On cuisine aussi les Baies! \n",
        "On fait des mélanges! C’est délicieux!"
      ]
    }
  ]
}