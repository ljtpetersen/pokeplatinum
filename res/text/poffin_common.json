    {
      "id": "PoffinCommon_Text_HereYouMayCookPoffins",
      "en_US": [
        "Hello!\r",
        "Here you may cook Berries and\n",
        "turn them into Poffins.\r"
      ],
      "fr_FR": [
        "Bonjour!\r",
        "Ici, vous pouvez cuisiner vos Baies\n",
        "pour en faire des Poffins.\r"
      ]
    },
    {
      "id": "PoffinCommon_Text_CookAloneOrWithOthers",
      "en_US": [
        "Would you like to cook alone or with\n",
        "other people?"
      ],
      "fr_FR": [
        "Voulez-vous cuisiner en solo ou\n",
        "en groupe?"
      ]
    },
    {
      "id": "PoffinCommon_Text_CommunicationsWillBeLaunched",
      "en_US": [
        "DS Wireless Communications will\n",
        "be launched."
      ],
      "fr_FR": [
        "La communication sans fil DS va\n",
        "démarrer."
      ]
    },
