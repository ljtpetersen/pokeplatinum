  "messages": [
    {
      "id": "OreburghCityWestHouse_Text_HaveYouSeenDifferentlyColoredPokemon",
      "en_US": [
        "Have you ever seen or heard about\n",
        "differently colored Pokémon?\r",
        "For instance, a regular PIKACHU has\n",
        "a yellow body, correct?\r",
        "Well, the different-colored PIKACHU\n",
        "has a sort of orange body."
      ],
      "fr_FR": [
        "Tu savais que certains Pokémon\n",
        "pouvaient avoir plusieurs couleurs?\r",
        "Par exemple, d’habitude, le corps des\n",
        "PIKACHU est jaune, pas vrai?\r",
        "Eh bien, il existe des PIKACHU\n",
        "dont le corps est orangé."
      ]
    },
    {
      "id": "OreburghCityWestHouse_Text_PokemonHaveDifferentNatures",
      "en_US": [
        "You know how Pokémon have different\n",
        "natures like we have personalities?\r",
        "I don’t think it’s surprising to see\n",
        "Pokémon in different colors."
      ],
      "fr_FR": [
        "Tu sais que les Pokémon ont des natures\n",
        "différentes...\r",
        "Alors ce n’est pas surprenant de voir\n",
        "des Pokémon de différentes couleurs."
      ]
    },
    {
      "id": "OreburghCityWestHouse_Text_PikachuCry",
      "en_US": "PIKACHU: Pikaaah!",
      "fr_FR": "PIKACHU: Pikaaah!"
    }
  ]
}