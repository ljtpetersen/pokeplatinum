    {
      "id": "SpearPillar_Text_SurprisedYouMadeIt",
      "en_US": [
        "Mars: I’m surprised you made it here.\n",
        "You can stay if you won’t meddle."
      ],
      "fr_FR": [
        "Mars: Je suis surprise que tu aies\n",
        "réussi à arriver jusque-là. Tu peux\f",
        "rester à condition de ne pas t’en mêler."
      ]
    },
    {
      "id": "SpearPillar_Text_BeQuietAndWatch",
      "en_US": [
        "Jupiter: Be quiet and watch what our\n",
        "boss is about to do."
      ],
      "fr_FR": [
        "Jupiter: Tais-toi et admire notre\n",
        "chef à l’œuvre."
      ]
    },
