{
  "key": 9227,
  "messages": [
    {
      "id": "VeilstoneStore5F_Text_GrabADrinkAndUnwind",
      "en_US": [
        "I’ve had enough of shopping for\n",
        "a while.\r",
        "I’ll grab a drink and unwind a bit."
      ],
      "fr_FR": [
        "J’ai fait assez de shopping pour\n",
        "le moment.\r",
        "Je vais prendre une boisson et me\n",
        "reposer."
      ]
    },
    {
      "id": "VeilstoneStore5F_Text_TheyConsiderMeARegular",
      "en_US": [
        "I’ve shopped here loyally for years.\n",
        "Now they consider me a regular! Ha!"
      ],
      "fr_FR": [
        "Je suis fidèle à ce magasin depuis des\n",
        "années. Tout le monde me connaît! Ha!"
      ]
    },
    {
      "id": "VeilstoneStore5F_Text_GiftThisStickyBarb",
      "en_US": [
        "Ah, young Pokémon Trainer...\r",
        "As your senior in life, let me make\n",
        "a gift of this Sticky Barb!\r"
      ],
      "fr_FR": [
        "Ah, jeune Dresseur Pokémon...\r",
        "Laisse-moi t’offrir ces Piquants,\n",
        "un cadeau de la part d’un aîné!\r"
      ]
    },
    {
      "id": "VeilstoneStore5F_Text_SticksToFoeInflictsDamage",
      "en_US": [
        "That Sticky Barb is a hold item.\n",
        "If the Pokémon holding it is hit...\r",
        "The Sticky Barb sticks to the foe\n",
        "and inflicts damage!"
      ],
      "fr_FR": [
        "C’est un objet à tenir. Si le Pokémon\n",
        "qui le tient est touché...\r",
        "Les Piquants se collent sur l’ennemi\n",
        "pour lui infliger des dégâts!"
      ]
    },
    {
      "id": "VeilstoneStore5F_Text_TwoBuffGuysSideBySide",
      "en_US": [
        "Two buff guys standing side by side.\n",
        "That’s all. What? What’s the problem?"
      ],
      "fr_FR": [
        "Où est le problème? Tu n’as jamais vu\n",
        "deux types musclés discuter ensemble?"
      ]
    },
    {
      "id": "VeilstoneStore5F_Text_Directory",
      "en_US": [
        "B1F: Food & Produce\r",
        "1F: Trainers’ Zone\r",
        "2F: Battle Collection\r",
        "3F: TM Corner\r",
        "4F: Poké Dolls & Goods\r",
        "5F: Rooftop Plaza"
      ],
      "fr_FR": [
        "-1: Alimentation\r",
        "RC: Espace Dresseurs\r",
        "1¹: Fournitures de Combat\r",
        "2⁴: Centre CT\r",
        "3⁴: Poupées Pokémon et articles\r",
        "4⁴: Terrasse"
      ]
    },
    {
      "id": "VeilstoneStore5F_Text_WhichDrinkWouldYouLike",
      "en_US": [
        "It’s a Vending Machine.\n",
        "Which drink would you like?"
      ],
      "fr_FR": [
        "C’est un Distributeur.\n",
        "Quelle boisson vous fait envie?"
      ]
    },
    {
      "id": "VeilstoneStore5F_Text_ACanDroppedDown",
      "en_US": [
        "Clang!\r",
        "A can of {STRVAR_1 8, 0, 0} dropped\n",
        "down.\r"
      ],
      "fr_FR": [
        "Clang!\r",
        "Une canette {STRVAR_1 8, 0, 0} vient\n",
        "de tomber.\r"
      ]
    },
    {
      "id": "VeilstoneStore5F_Text_ABonusCanDroppedDown",
      "en_US": [
        "Clang!\r",
        "Bonus! Another can of {STRVAR_1 8, 0, 0}\n",
        "dropped down.\r"
      ],
      "fr_FR": [
        "Clang!\r",
        "Bonus! Une autre canette\n",
        "{STRVAR_1 8, 0, 0} vient de tomber.\r"
      ]
    },
    {
      "id": "VeilstoneStore5F_Text_NotEnoughMoney",
      "en_US": "Not enough money...",
      "fr_FR": "Vous n’avez pas assez d’argent..."
    },
    {
      "id": "VeilstoneStore5F_Text_DecidedNotToBuyADrink",
      "en_US": "Decided not to buy a drink.",
      "fr_FR": "Vous changez d’avis."
    }
  ]
}