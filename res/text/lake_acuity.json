{
  "key": 9295,
  "messages": [
    {
      "id": "LakeAcuity_Text_YoureNotGettingAway",
      "en_US": [
        "{STRVAR_1 3, 0, 0}: !\r",
        "You’re not getting away with this,\n",
        "Team Galactic!\r"
      ],
      "fr_FR": [
        "{STRVAR_1 3, 0, 0}: !\r",
        "Vous ne vous en tirerez pas à si bon \n",
        "compte, Team Galaxie!\r"
      ]
    },
    {
      "id": "LakeAcuity_Text_BackToVeilstoneCity",
      "en_US": [
        "Jupiter: Oh?\n",
        "Are you finished already?\r",
        "Your Pokémon aren’t bad, but you’re\n",
        "laughably weak.\r",
        "You honestly thought you could save\n",
        "the Pokémon of the lake?\r",
        "And become the Pokémon Champion?\n",
        "Dream on, little kid.\r",
        "But, eww, it’s so cold here.\n",
        "Let’s go back to the Veilstone HQ.\r"
      ],
      "fr_FR": [
        "Jupiter: Oh?\n",
        "C’est déjà terminé?\r",
        "Tes Pokémon ne sont pas mauvais, mais\n",
        "tu es d’une faiblesse embarrassante.\r",
        "Tu pensais sincèrement pouvoir sauver\n",
        "les Pokémon du lac?\r",
        "Et devenir un Maître Pokémon?\n",
        "Continue de rêver, petit Dresseur.\r",
        "Enfin... Brr, il fait froid ici.\n",
        "Je rentre au QG de Voilaroc.\r"
      ]
    },
    {
      "id": "LakeAcuity_Text_DontWasteYourTime",
      "en_US": [
        "Oh? Don’t I know you?\n",
        "We met in Eterna City.\r",
        "Listen. Team Galactic is going to do\n",
        "something huge for everyone’s sake.\r",
        "That’s why you should keep out of\n",
        "Team Galactic’s way.\r",
        "Don’t come whining about poor Pokémon\n",
        "and other trivial junk like that.\r",
        "Don’t waste your time coming to our\n",
        "HQ in Veilstone.\r",
        "Now, if you’ll excuse me.\r"
      ],
      "fr_FR": [
        "Oh? Je te connais, non?\n",
        "Tu te souviens, à Vestigion?\r",
        "Ecoute. La Team Galaxie travaille\n",
        "pour le bien de l’humanité.\r",
        "C’est pourquoi tu ne devrais pas\n",
        "essayer de t’interposer.\r",
        "Ne viens pas pleurnicher sur ces \n",
        "pauvres Pokémon ou ce genre d’idioties.\r",
        "Et ne perds pas ton temps à rejoindre\n",
        "notre QG de Voilaroc.\r",
        "Maintenant, si tu veux bien m’excuser.\r"
      ]
    },
    {
      "id": "LakeAcuity_Text_ICouldntDoAnything",
      "en_US": [
        "{STRVAR_1 3, 0, 0}: ...\n",
        "...\r",
        "Yeah, that’s right!\r",
        "I couldn’t do anything against Team\n",
        "Galactic!\r"
      ],
      "fr_FR": [
        "{STRVAR_1 3, 0, 0}: ...\n",
        "...\r",
        "Bon, d’accord!\r",
        "Je n’ai rien pu faire contre la\n",
        "Team Galaxie!\r"
      ]
    },
    {
      "id": "LakeAcuity_Text_UxieWasSuffering",
      "en_US": [
        "That Pokémon called UXIE...\n",
        "It was suffering...\r"
      ],
      "fr_FR": [
        "Ce Pokémon, CREHELF...\n",
        "Il souffrait...\r"
      ]
    },
    {
      "id": "LakeAcuity_Text_IHaveToBeStronger",
      "en_US": [
        "I’m going to get tougher...\r",
        "It’s not about winning or losing...\n",
        "That’s not good enough...\f",
        "I have to be stronger...\r",
        "It’s not enough to just want to be the\n",
        "most powerful Trainer ever...\r",
        "It takes honest effort...\n",
        "And a determined heart.\r"
      ],
      "fr_FR": [
        "Je vais m’endurcir...\r",
        "La victoire, la défaite...\n",
        "C’est insignifiant...\f",
        "Je dois juste m’endurcir...\r",
        "Pour devenir le meilleur des Dresseurs,\n",
        "il ne suffit pas de le vouloir...\r",
        "Ça demande du travail...\n",
        "Et du cœur à l’ouvrage.\r"
      ]
    }
  ]
}