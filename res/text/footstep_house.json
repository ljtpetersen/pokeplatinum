      "fr_FR": [
        "{STRVAR_1 1, 2, 0} travaille dur pour\n",
        "faire plaisir à {STRVAR_1 3, 1, 0}.\r",
        "Les ronds, les carrés, les\n",
        "triangles, les tout doux...\r",
        "{STRVAR_1 1, 2, 0} veut voir toutes\n",
        "sortes de Pokémon...\r"
      ]
    },
    {
      "id": "FootstepHouse_Text_Cute_NoPrint_Level4",
      "en_US": [
        "{STRVAR_1 1, 2, 0} and {STRVAR_1 3, 1, 0}\n",
        "make a friendly combo.\r",
        "{STRVAR_1 3, 1, 0}’s feelings, {STRVAR_1 1, 2, 0}\n",
