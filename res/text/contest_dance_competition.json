      "id": "DanceCompetition_Text_CompetitionIsReady",
      "en_US": [
        "The Dance Competition is ready to\n",
        "get under way!\r",
        "Can the backup dancers flawlessly\n",
        "follow the main dancer’s steps?!\r",
        "OK! Everybody, let’s dance!\n",
        "Start the music!\r"
      ],
      "fr_FR": [
        "L’Epreuve de Danse va bientôt\n",
        "commencer!\r",
        "Nos concurrents pourront-ils suivre la\n",
        "chorégraphie sans faire d’erreurs?\r",
        "OK! Dansons!\n",
        "Envoyez la musique!\r"
      ]
    },
