{
  "key": 37979,
  "messages": [
    {
      "id": "BattleArcade_Text_WelcomeToSingleDoubleChallenge",
      "en_US": [
        "Welcome to the Battle Arcade!\r",
        "I am your guide to the Single and\n",
        "Double Battle challenges.\r",
        "Please be aware that these challenges\n",
        "are designed for a single Trainer.\r"
      ],
      "fr_FR": [
        "Bienvenue à l’Arcade de Combat!\r",
        "Je suis votre guide pour les \n",
        "Combats Solo et Duo.\r",
        "Ils sont conçus pour un seul\n",
        "Dresseur.\r"
      ]
    },
    {
      "id": "BattleArcade_Text_TakeWhichChallenge",
      "en_US": "Which challenge would you like to take?",
      "fr_FR": "Quel défi souhaitez-vous relever?"
    },
    {
      "id": "BattleArcade_Text_ExplainSingleDoubleChallenge",
      "en_US": [
        "At the Battle Arcade, you may take a\n",
        "Single or Double Battle challenge.\r",
        "Here, a game board is activated\n",
        "before every match.\r",
        "Depending on what comes up on the\n",
        "game board, an event takes place.\r",
        "Some events will be good for the\n",
        "challenger, while others won’t be.\r",
        "The objective is to keep a winning\n",
        "streak alive as long as possible.\r",
        "During your challenge, any items held by\n",
        "your Pokémon will be kept in storage.\r",
        "If you manage to win seven matches in\n",
        "a row, you will earn Battle Points (BP).\r",
        "If you want to interrupt your\n",
        "challenge, please save the game.\r",
        "If you don’t save, you will be\n",
        "disqualified from your challenge.\r",
        "Please be aware of that!\r"
      ],
      "fr_FR": [
        "L’Arcade de Combat propose des\n",
        "Combats Solo et des Combats Duo.\r",
        "Avant chaque match, un tableau de jeu\n",
        "décide aléatoirement des conditions\f",
        "du combat à venir.\r",
        "Celles-ci peuvent s’avérer favorables\n",
        "au candidat, ou l’inverse.\r",
        "Le but est d’enchaîner le plus de\n",
        "victoires possible.\r",
        "Les objets tenus par vos Pokémon\n",
        "seront consignés le temps du défi.\r",
        "Remportez sept combats à la suite et\n",
        "vous gagnerez des Points de Combat.\r",
        "Si vous voulez interrompre votre \n",
        "progression, vous devrez sauvegarder.\r",
        "Si vous ne le faites pas, nous \n",
        "devrons vous disqualifier.\r"
      ]
    },
    {
      "id": "BattleArcade_Text_WelcomeToMultiChallenge",
      "en_US": [
        "Welcome to the Battle Arcade!\r",
        "I am your guide to the Multi Battle\n",
        "challenge.\r",
        "Please be aware that this challenge\n",
        "requires two Trainers.\r"
      ],
      "fr_FR": [
        "Bienvenue à l’Arcade de Combat!\r",
        "Je serai votre guide pour les\n",
        "Combats Multi!\r",
        "Ils sont conçus pour des équipes\n",
        "de deux Dresseurs.\r"
      ]
    },
    {
      "id": "BattleArcade_Text_AskTakeMultiChallenge",
      "en_US": [
        "Would you like to take the Battle\n",
        "Arcade Multi Battle challenge?"
      ],
      "fr_FR": [
        "Voulez-vous relever le défi du\n",
        "Combat Multi?"
      ]
    },
    {
      "id": "BattleArcade_Text_ExplainMultiChallenge",
      "en_US": [
        "You may team up with a friend for a\n",
        "Multi Battle challenge.\r",
        "Here, a game board is activated\n",
        "before every match.\r",
        "Depending on what comes up on the\n",
        "game board, an event takes place.\r",
        "The events may have great impact on\n",
        "the match’s outcome, good or bad.\r",
        "The objective is to keep a winning\n",
        "streak alive as long as possible.\r",
        "During your challenge, any items held by\n",
        "your Pokémon will be kept in storage.\r",
        "If you manage to win seven matches in\n",
        "a row, you will earn Battle Points (BP).\r",
        "Please note: a Battle Arcade Multi\n",
        "Battle challenge can’t be interrupted.\r"
      ],
      "fr_FR": [
        "Pour les Combats Multi, vous pouvez\n",
        "faire équipe avec un ami.\r",
        "Ici, avant chaque match, un tableau de\n",
        "jeu décide aléatoirement des conditions\f",
        "du combat à venir.\r",
        "Celles-ci peuvent avoir un certain\n",
        "impact sur l’issue du combat.\r",
        "Le but est d’enchaîner le plus de\n",
        "victoires possible.\r",
        "Les objets tenus par vos Pokémon\n",
        "seront consignés le temps du défi.\r",
        "Remportez sept combats à la suite et\n",
        "vous gagnerez des Points de Combat.\r",
        "Notez bien qu’à l’Arcade de Combat, les\n",
        "Combats Multi ne peuvent être\f",
        "interrompus.\r"
      ]
    },
    {
      "id": "BattleArcade_Text_HopeToSeeYouAgain",
      "en_US": "We hope to see you again!",
      "fr_FR": "A une prochaine fois peut-être!"
    },
    {
      "id": "BattleArcade_Text_SelectPokemonToEnter",
      "en_US": [
        "Please select the Pokémon you wish\n",
        "to enter.\r"
      ],
      "fr_FR": "Veuillez choisir les Pokémon à inscrire.\r"
    },
    {
      "id": "BattleArcade_Text_NotEnoughEligiblePokemon",
      "en_US": [
        "Excuse me!\r",
        "You don’t have {STRVAR_1 50, 0, 0} eligible Pokémon.\r",
        "You must have {STRVAR_1 50, 1, 0} different Pokémon\n",
        "to enter.\r"
      ],
