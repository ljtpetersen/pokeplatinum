  "messages": [
    {
      "id": "AmitySquare_Text_PermittedList",
      "en_US": [
        "In Amity Square, you may go for\n",
        "a stroll with a cute Pokémon.\r",
        "The permitted Pokémon are: \n",
        "TURTWIG,{CURSOR_X 70}GROTLE,{CURSOR_X 140}TORTERRA,\f",
        "CHIMCHAR,{CURSOR_X 70}MONFERNO,{CURSOR_X 140}INFERNAPE,\f",
        "PIPLUP,{CURSOR_X 70}PRINPLUP,{CURSOR_X 140}EMPOLEON,\f",
        "PIKACHU,{CURSOR_X 70}CLEFAIRY,{CURSOR_X 140}PSYDUCK,\f",
        "PACHIRISU,{CURSOR_X 70}HAPPINY,{CURSOR_X 140}BUNEARY,\f",
        "and DRIFLOON!\r",
        "Please do come back with one!\r"
      ],
      "fr_FR": [
        "Au Square Paisible, vous pouvez vous\n",
        "promener avec un Pokémon gracieux.\r",
        "Les Pokémon autorisés sont: \n",
        "TORTIPOUSS, {CURSOR_X 70}BOSKARA, {CURSOR_X 140}TORTERRA,\f",
        "OUISTICRAM, {CURSOR_X 70}CHIMPENFEU, {CURSOR_X 140}SIMIABRAZ,\f",
        "TIPLOUF, {CURSOR_X 70}PRINPLOUF, {CURSOR_X 140}PINGOLEON,\f",
        "PIKACHU, {CURSOR_X 70}MELOFEE, {CURSOR_X 140}PSYKOKWAK,\f",
        "PACHIRISU, {CURSOR_X 70}PTIRAVI, {CURSOR_X 140}LAPOREILLE,\f",
        "et BAUDRIVE!\r",
        "Revenez avec l’un d’entre eux!\r"
      ]
    },
