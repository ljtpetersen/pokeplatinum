    {
      "id": "VeilstoneCityNorthwestHouse_Text_MtCoronetPartedSinnoh",
      "en_US": [
        "A myth says that Mt. Coronet parted\n",
        "Sinnoh into halves.\r",
        "Seeing the Pokémon SHELLOS makes me\n",
        "think maybe the myth is real."
      ],
      "fr_FR": [
        "Un mythe prétend que le Mont Couronné\n",
        "sépare Sinnoh en deux.\r",
        "A voir le Pokémon SANCOKI, j’ai \n",
        "l’impression que ce mythe dit vrai."
      ]
    },
    {
      "id": "VeilstoneCityNorthwestHouse_Text_PokemonAppearInManyGuises",
      "en_US": [
        "If there are people who desire to\n",
        "see them, Pokémon will appear in\f",
        "many different guises."
      ],
      "fr_FR": [
        "Les Pokémon peuvent revêtir de\n",
        "nombreuses formes pour berner\f",
        "ceux qui les recherchent."
      ]
    },
    {
      "id": "VeilstoneCityNorthwestHouse_Text_BunearyCry",
      "en_US": "BUNEARY: Nii nii!",
      "fr_FR": "LAPOREILLE: Lapii lapii!"
    }
  ]
