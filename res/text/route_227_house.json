{
  "key": 7819,
  "messages": [
    {
      "id": "Route227House_Text_RestUp",
      "en_US": [
        "Oh, dear, are your Pokémon feeling\n",
        "tired?\r",
        "You should rest up.\n",
        "Yes, good idea! Rest up here!"
      ],
      "fr_FR": [
        "Oh, quelle fière équipe! Mais\n",
        "vous semblez épuisés!\r",
        "Si tu veux, tu peux te reposer \n",
        "ici. Bonne idée, non?"
      ]
    },
    {
      "id": "Route227House_Text_GetSomeRest",
      "en_US": [
        "Yes, yes, that’s right.\n",
        "Get some well-earned rest.\r"
      ],
      "fr_FR": [
        "Voilà qui est sage! Tu as bien \n",
        "mérité un peu de repos.\r"
      ]
    },
    {
      "id": "Route227House_Text_RestUpAgain",
      "en_US": [
        "Oh, you’re still looking tired.\n",
        "You’re still needing rest, are you?\r",
        "You should rest up again.\n",
        "Yes, good idea! Rest up here!"
      ],
      "fr_FR": [
        "Oh, pauvre Dresseur! Cette route\n",
        "était vraiment épuisante, pas vrai?\r",
        "Si tu veux, tu peux te reposer\n",
        "encore un peu. Bonne idée, non?"
      ]
    },
    {
      "id": "Route227House_Text_IsThatRight",
      "en_US": [
        "Is that right?\n",
        "You’re sure now?\r",
        "I’m only concerned for your sake. No\n",
        "need to worry about putting me out!"
      ],
      "fr_FR": [
        "Vraiment? C’est ton dernier mot?\r",
        "Ça te ferait du bien, tu sais? Et ça me \n",
        "ferait plaisir si tu acceptais."
      ]
    }
  ]
}