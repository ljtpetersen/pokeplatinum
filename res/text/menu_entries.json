    {
      "id": "MenuEntries_Text_PC_DescriptionDepositPokemon",
      "en_US": [
        "Pokémon in your party may be stored\n",
        "in the storage system’s Boxes."
      ],
      "fr_FR": [
        "Déposer des Pokémon de l’équipe dans\n",
        "des Boîtes."
      ]
    },
    {
      "id": "MenuEntries_Text_PC_DescriptionWithdrawPokemon",
      "en_US": [
        "Pokémon stored in Boxes may be added\n",
        "to your party."
      ],
      "fr_FR": [
        "Intégrer dans l’équipe des Pokémon se\n",
        "trouvant dans les Boîtes."
      ]
    },
    {
      "id": "MenuEntries_Text_PC_DescriptionMovePokemon",
      "en_US": [
        "You may sort the Pokémon in Boxes\n",
        "and in your party."
      ],
      "fr_FR": [
        "Organiser les Pokémon dans les Boîtes\n",
        "et dans l’équipe."
      ]
    },
    {
      "id": "MenuEntries_Text_PC_DescriptionMoveItems",
      "en_US": [
        "You may sort the items held by your\n",
        "Pokémon in Boxes and in your party."
      ],
      "fr_FR": [
        "Déplacer des objets tenus par des\n",
        "Pokémon d’une Boîte ou de l’équipe."
      ]
    },
    {
      "id": "MenuEntries_Text_PC_DescriptionComparePokemon",
      "en_US": [
        "You may compare two Pokémon in Boxes\n",
        "or your party side by side."
      ],
      "fr_FR": [
        "Comparer deux Pokémon d’une Boîte\n",
        "ou de l’équipe."
      ]
    },
    {
      "id": "MenuEntries_Text_PC_DescriptionSeeYa",
      "en_US": [
        "Log out of the Pokémon Storage\n",
        "System."
      ],
      "fr_FR": [
        "Fermer le système de Gestion de\n",
        "Stocks de Pokémon."
      ]
    },
    {
      "id": "MenuEntries_Text_PC_DescriptionMailBox",
      "en_US": [
        "Up to 20 pieces of Mail can be\n",
        "stored."
      ],
      "fr_FR": [
        "Vous pouvez stocker jusqu’à 20\n",
        "Lettres."
      ]
    },
    {
      "id": "MenuEntries_Text_PC_DescriptionBallCapsules",
      "en_US": [
        "You may set or edit capsules for\n",
        "decorating Poké Balls."
      ],
      "fr_FR": [
        "Vous pouvez appliquer ou modifier des\n",
        "capsules pour décorer les Poké Balls."
      ]
    },
    {
      "id": "MenuEntries_Text_PC_DescriptionLogOut",
      "en_US": "Log out of your PC.",
      "fr_FR": "Eteindre votre PC."
    },
