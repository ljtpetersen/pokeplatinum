      "id": "BattleHall_Text_MustSaveBeforeResuming",
      "en_US": [
        "We’ve missed you!\r",
        "You must save the game before you\n",
        "resume your challenge. Please wait."
      ],
      "fr_FR": [
        "Contents de vous revoir!\r",
        "Vous devez sauvegarder la partie avant\n",
        "de reprendre le défi.\r",
        "Veuillez patienter."
      ]
    },
    {
      "id": "BattleHall_Text_DidntSaveBeforeQuit",
      "en_US": [
        "Excuse me!\r",
        "You didn’t save before you quit your\n",
        "challenge last time.\r",
        "Because of that, you have been\n",
        "disqualified from your challenge!\r"
      ],
      "fr_FR": [
        "Je regrette.\r",
        "Vous n’avez pas sauvegardé avant\n",
        "l’interruption de votre dernier défi.\r",
        "En conséquence, nous sommes \n",
        "obligés de vous disqualifier!\r"
      ]
    },
    {
      "id": "BattleHall_Text_PrintForVictory",
