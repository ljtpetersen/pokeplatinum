  "messages": [
    {
      "id": "RotomsRoom_Text_TryingToLearnMove",
      "en_US": [
        "{STRVAR_1 0, 0, 0} entered the motor.\r",
        "{STRVAR_1 0, 0, 0} is trying to\n",
        "learn {STRVAR_1 6, 1, 0}.\r",
        "But {STRVAR_1 0, 0, 0} can’t learn\n",
        "more than four moves.\r",
        "Delete a move to make\n",
        "room for {STRVAR_1 6, 1, 0}?"
      ],
      "fr_FR": [
        "{STRVAR_1 0, 0, 0} est entré dans le moteur.\r",
        "{STRVAR_1 0, 0, 0} tente d’apprendre\n",
        "{STRVAR_1 6, 1, 0}.\r",
        "Mais {STRVAR_1 0, 0, 0} ne peut pas\n",
        "avoir plus de quatre capacités.\r",
        "Effacer une ancienne capacité pour\n",
        "{STRVAR_1 6, 1, 0}?"
      ]
    },
    {
      "id": "RotomsRoom_Text_GiveUpLearningMove",
      "en_US": [
        "Give up on learning the move\n",
