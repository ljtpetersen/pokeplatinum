{
  "key": 55507,
  "messages": [
    {
      "id": "CommonStrings_Text_PokecenterGreeting_Day",
      "en_US": [
        "Hello, and welcome to\n",
        "the Pokémon Center.\r",
        "We restore your tired Pokémon\n",
        "to full health.\r",
        "Would you like to rest your Pokémon?"
      ],
      "fr_FR": [
        "Bonjour! Bienvenue au \n",
        "Centre Pokémon.\r",
        "Nous pouvons soigner vos Pokémon.\r",
        "Voulez-vous les soigner?"
      ]
    },
    {
      "id": "CommonStrings_Text_PokecenterTakeYourPokemon",
      "en_US": [
        "OK, I’ll take your Pokémon for a few\n",
        "seconds."
      ],
      "fr_FR": [
        "OK, je prends vos Pokémon un\n",
        "instant."
      ]
    },
    {
      "id": "CommonStrings_Text_PokecenterRestoredYourPokemon",
      "en_US": [
        "Thank you for waiting.\r",
        "We’ve restored your Pokémon to full\n",
        "health.\r"
      ],
      "fr_FR": [
        "Merci d’avoir attendu.\r",
        "Vos Pokémon sont en super\n",
        "forme maintenant.\r"
      ]
    },
    {
      "id": "CommonStrings_Text_PokecenterHopeToSeeYouAgain1",
      "en_US": "We hope to see you again!",
      "fr_FR": "A une prochaine fois peut-être!"
    },
    {
      "id": "CommonStrings_Text_PokecenterGreeting_Interrupted",
      "en_US": [
        "Hello, and welcome to\n",
        "the Pokémon Center.\r",
        "We restore your tired Pokémon\n",
        "to full health.\r",
        "Would you like to...\r"
      ],
      "fr_FR": [
        "Bonjour! Bienvenue au \n",
        "Centre Pokémon.\r",
        "Nous pouvons soigner vos Pokémon.\r",
        "Voulez-vous les...\r"
      ]
    },
    {
      "id": "CommonStrings_Text_PokecenterThatTrainerCard",
      "en_US": [
        "Th-that Trainer Card!\r",
        "That sparkling color!\n",
        "And all those stars!\r",
        "I’ve seen several Trainers with Silver\n",
        "Trainer Cards up to now...\r",
        "But you’re the first to top them\n",
        "with that Trainer Card.\r",
        "Please, {STRVAR_1 3, 0, 0}, may I have\n",
        "the honor of healing your Pokémon?"
      ],
      "fr_FR": [
        "Cette... Carte de Dresseur!\r",
        "Quelle couleur!\n",
        "Et toutes ces étoiles!\r",
        "J’ai déjà vu plusieurs Dresseurs avec \n",
        "une Carte de Dresseur Argent...\r",
        "Mais vous les surpassez \n",
        "tous avec cette carte.\r",
        "S’il vous plaît, {STRVAR_1 3, 0, 0}, puis-je \n",
        "avoir l’honneur de soigner vos Pokémon?"
      ]
    },
    {
      "id": "CommonStrings_Text_PokecenterGreatToSeeYou",
      "en_US": [
        "It’s great to see you, {STRVAR_1 3, 0, 0}!\n",
        "You want the usual, am I right?"
      ],
      "fr_FR": [
        "Contente de vous revoir, {STRVAR_1 3, 0, 0}!\n",
        "La même chose que la dernière fois?"
      ]
    },
    {
      "id": "CommonStrings_Text_PokecenterTakeYourPokemon_GoldCard",
      "en_US": [
        "I will be pleased to take your\n",
        "Pokémon for a few seconds."
      ],
      "fr_FR": "OK, je prends vos Pokémon un instant."
    },
    {
      "id": "CommonStrings_Text_PokecenterThankYouForWaiting",
      "en_US": "Thank you for waiting.",
      "fr_FR": "Merci d’avoir patienté."
    },
    {
      "id": "CommonStrings_Text_PokecenterHopeToSeeYouAgain2",
      "en_US": "We hope to see you again!",
      "fr_FR": "Encore merci et à bientôt!"
    },
    {
      "id": "CommonStrings_Text_PokecenterPokemonMayBeInfected",
      "en_US": [
        "Your Pokémon may be infected with\n",
        "the Pokérus.\r",
        "Little is known about the Pokérus\n",
        "except that they are microscopic\f",
        "life-forms that attach to Pokémon.\r",
        "While infected, Pokémon are said to\n",
        "grow exceptionally well."
      ],
      "fr_FR": [
        "Ton Pokémon a peut-être attrapé\n",
        "le Pokérus.\r",
        "On sait peu de choses sur les Pokérus,\n",
        "si ce n’est qu’il s’agit d’organismes\f",
        "vivants microscopiques se fixant sur\f",
        "les Pokémon.\r",
        "Il paraît que les Pokémon contaminés\n",
        "se développent incroyablement bien."
      ]
    },
    {
      "id": "CommonStrings_Text_OutOfPokemonVisionDimmed",
      "en_US": [
        "{STRVAR_1 3, 0, 0} is out of battle-ready\n",
        "Pokémon!\r",
        "{STRVAR_1 3, 0, 0}’s vision dimmed!"
      ],
      "fr_FR": [
        "{STRVAR_1 3, 0, 0} n’a plus de \n",
        "Pokémon en forme!\r",
        "{STRVAR_1 3, 0, 0} est hors-jeu!"
      ]
    },
    {
      "id": "CommonStrings_Text_Dummy12",
      "garbage": 13
    },
    {
      "id": "CommonStrings_Text_WouldYouLikeToSave",
      "en_US": "Would you like to save the game?",
      "fr_FR": "Voulez-vous sauvegarder la partie?"
    },
    {
      "id": "CommonStrings_Text_OKToOverwriteSavedFile",
      "en_US": [
        "There is already a saved file.\n",
        "Is it OK to overwrite it?"
      ],
      "fr_FR": [
        "Il y a déjà une sauvegarde.\n",
        "Voulez-vous la remplacer?"
      ]
    },
    {
      "id": "CommonStrings_Text_SavingDontTurnOffThePower",
      "en_US": [
        "Saving...\n",
        "Don’t turn off the power."
      ],
      "fr_FR": [
        "Sauvegarde en cours...\n",
        "Ne pas éteindre."
      ]
    },
    {
      "id": "CommonStrings_Text_PlayerSavedTheGame",
      "en_US": "{STRVAR_1 3, 0, 0} saved the game.",
      "fr_FR": "{STRVAR_1 3, 0, 0} a sauvegardé la partie."
    },
    {
      "id": "CommonStrings_Text_00017",
      "en_US": [
        "Warning!\n",
        "There is already a saved game file.\r",
        "If you save now, the other file’s\n",
        "adventure, including items and\f",
        "Pokémon, will be entirely lost.\r",
        "Are you sure you want to save now\n",
        "and overwrite the other save file?"
      ],
      "fr_FR": [
        "Attention!\n",
        "Une autre partie est déjà sauvegardée.\r",
        "Si vous sauvegardez maintenant,\n",
        "l’aventure, les objets et les Pokémon\f",
        "de l’autre fichier seront perdus.\r",
        "Etes-vous sûr de vouloir écraser\n",
        "l’autre fichier?"
      ]
    },
    {
      "id": "CommonStrings_Text_SaveError",
      "en_US": "Save error.",
      "fr_FR": "Erreur de sauvegarde."
    },
    {
      "id": "CommonStrings_Text_00019",
      "en_US": [
        "Saving...\n",
        "Don’t turn off the power."
      ],
      "fr_FR": [
        "Sauvegarde en cours...\n",
        "Ne pas éteindre."
      ]
    },
    {
      "id": "CommonStrings_Text_ImpossibleToSave",
      "en_US": [
        "There is already a saved game file.\n",
        "It is impossible to save.\r",
        "Please refer to the Instruction\n",
        "Booklet for details.\r",
        "Press Up + SELECT + B Button on\n",
        "the title screen if you want to erase\f",
        "the current saved game file."
      ],
      "fr_FR": [
        "Une autre partie est déjà sauvegardée.\n",
        "Sauvegarde impossible.\r",
        "Veuillez vous référer au \n",
        "manuel pour plus d’informations.\r",
        "Appuyez sur haut, SELECT et le\n",
        "bouton B à l’écran titre pour effacer\f",
        "la sauvegarde actuelle."
      ]
    },
    {
      "id": "CommonStrings_Text_SavingALotOfData",
      "en_US": [
        "Saving a lot of data...\n",
        "Don’t turn off the power."
      ],
      "fr_FR": [
        "Sauvegarde de beaucoup de données...\n",
        "Ne pas éteindre."
