  "messages": [
    {
      "id": "LakeVerity_Text_YouveGotToHelpDawn",
      "en_US": [
        "Rowan: Ah, {STRVAR_1 3, 0, 0}!\n",
        "What timing!\r",
        "Those Team Galactic scoundrels are\n",
        "after the legendary Pokémon!\r",
        "You’ve got to help Dawn!"
      ],
      "fr_FR": [
        "Sorbier: Ah, {STRVAR_1 3, 0, 0}!\n",
        "Tu tombes à pic!\r",
        "Ces voyous de la Team Galaxie \n",
        "poursuivent le Pokémon légendaire!\r",
        "Tu dois aider Aurore!"
      ]
    },
    {
      "id": "LakeVerity_Text_YouveGotToHelpLucas",
      "en_US": [
        "Rowan: Ah, {STRVAR_1 3, 0, 0}!\n",
        "What timing!\r",
        "Those Team Galactic scoundrels are\n",
        "after the legendary Pokémon!\r",
        "{STRVAR_1 3, 0, 0}, help us!\n",
        "You’ve got to help Lucas!"
      ],
      "fr_FR": [
        "Sorbier: Ah, {STRVAR_1 3, 0, 0}!\n",
        "Tu tombes à pic!\r",
        "Ces voyous de la Team Galaxie \n",
        "poursuivent le Pokémon légendaire!\r",
        "Tu dois aider Louka!"
      ]
    },
    {
      "id": "LakeVerity_Text_HowDareYou",
      "en_US": [
        "Rowan: How dare you!\n",
        "You misguided thugs!\r"
      ],
      "fr_FR": [
        "Sorbier: Comment osez-vous, \n",
        "fripouilles incultes!\r"
      ]
    },
    {
      "id": "LakeVerity_Text_DawnNeedsYourHelp",
      "en_US": [
        "{STRVAR_1 3, 0, 0}!\n",
        "Dawn needs your help!"
      ],
      "fr_FR": [
        "{STRVAR_1 3, 0, 0}!\n",
        "Aurore a besoin de ton aide!"
      ]
    },
    {
      "id": "LakeVerity_Text_HowDareYou_Unused",
      "en_US": [
        "Rowan: How dare you!\n",
