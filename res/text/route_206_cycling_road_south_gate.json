    {
      "id": "Route206CyclingRoadSouthGate_Text_OpenOnlyToCyclists",
      "en_US": [
        "Cycling Road is open only to cyclists.\n",
        "You must be on a Bicycle.\r"
      ],
      "fr_FR": [
        "La Piste Cyclable est réservée aux\n",
        "cyclistes. Montez sur votre Bicyclette.\r"
      ]
    },
    {
      "id": "Route206CyclingRoadSouthGate_Text_LearnHowToShiftGears",
      "en_US": [
        "Learn how to shift gears, and you’ll\n",
        "be able to ride anywhere."
      ],
      "fr_FR": [
        "Apprenez à passer les vitesses et\n",
        "vous pourrez aller n’importe où."
      ]
    },
    {
      "id": "Route206CyclingRoadSouthGate_Text_HaveAFlag",
      "en_US": [
        "What’s a Bicycle without this?\r",
        "You’ve got to have a Flag!\n",
        "It’s a Pokémon Accessory!\r"
      ],
      "fr_FR": [
        "C’est le dernier chic pour ta \n",
        "Bicyclette!\r",
        "Il te faut un Drapeau!\n",
        "C’est un Accessoire Pokémon!\r"
      ]
    },
    {
      "id": "Route206CyclingRoadSouthGate_Text_GoThroughMtCoronet",
      "en_US": [
        "Go through Mt. Coronet from here,\n",
        "and you can get to Hearthome City.\r",
        "Hearthome is where they hold Pokémon\n",
        "Contests.\r",
        "You should dress up your Pokémon for\n",
        "Contests with your Accessories."
      ],
      "fr_FR": [
        "Traverse le Mont Couronné en partant \n",
        "d’ici pour rejoindre Unionpolis.\r",
        "C’est à Unionpolis que se tiennent\n",
        "les Concours Pokémon.\r",
        "Mets des Accessoires sur tes\n",
        "Pokémon pour participer aux Concours."
      ]
    }
  ]
