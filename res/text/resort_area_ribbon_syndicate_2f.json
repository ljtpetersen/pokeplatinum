{
  "key": 17418,
  "messages": [
    {
      "id": "ResortAreaRibbonSyndicate2F_Text_CareToHaveSpaTreatment",
      "en_US": [
        "How may we serve you today?\n",
        "Perhaps a spa treatment?\r",
        "Our spa treatment will make your\n",
        "{STRVAR_1 1, 1, 0} grow more friendly.\r",
        "Would you care to have a spa\n",
        "treatment, {STRVAR_1 3, 0, 0}?"
      ],
      "fr_FR": [
        "Qu’est-ce qui vous ferait plaisir?\n",
        "Peut-être un soin relaxant?\r",
        "Notre soin relaxant rendra votre\n",
        "{STRVAR_1 1, 1, 0} plus amical.\r",
        "Cela vous intéresse, {STRVAR_1 3, 0, 0}?"
      ]
    },
    {
      "id": "ResortAreaRibbonSyndicate2F_Text_SeeYouAgain",
      "en_US": "We hope to see you again.",
      "fr_FR": "Au plaisir de vous revoir."
    },
    {
      "id": "ResortAreaRibbonSyndicate2F_Text_RightThisWayPlease",
      "en_US": [
        "Ah, yes.\n",
        "Right this way, please...\r"
      ],
      "fr_FR": [
        "Ah, bien.\n",
        "Par ici s’il vous plaît...\r"
      ]
    },
    {
      "id": "ResortAreaRibbonSyndicate2F_Text_ReadyToBegin",
      "en_US": [
        "We’re ready to begin.\n",
        "Please, relax all your muscles.\r"
      ],
      "fr_FR": [
        "Nous allons commencer. Détendez-vous \n",
        "et relâchez bien tous vos muscles.\r"
      ]
    },
    {
      "id": "ResortAreaRibbonSyndicate2F_Text_OilContainsDiamonds",
      "en_US": [
        "This oil contains dissolved diamonds\n",
        "for enhanced effectiveness.\r"
      ],
      "fr_FR": [
        "Cette huile de bain contient des \n",
        "diamants dissous pour plus d’efficacité.\r"
      ]
    },
    {
      "id": "ResortAreaRibbonSyndicate2F_Text_FoamContainsPearls",
      "en_US": [
        "This foam contains an extract taken\n",
        "from pearls.\r"
      ],
      "fr_FR": [
        "Cette mousse contient des \n",
        "extraits de perles.\r"
      ]
    },
    {
      "id": "ResortAreaRibbonSyndicate2F_Text_ToxinsForcedOut",
      "en_US": [
        "The body’s toxins are forced out with\n",
        "a foreign massage technique.\r"
      ],
      "fr_FR": [
        "Notre technique de massage ancestrale\n",
        "permet d’expulser toutes les toxines.\r"
      ]
    },
    {
      "id": "ResortAreaRibbonSyndicate2F_Text_PerfumedByAroma",
      "en_US": [
        "The salon’s air is perfumed by an\n",
        "herbal aroma for relaxation.\r"
      ],
      "fr_FR": [
        "Nous diffusons des essences\n",
        "aromatiques relaxantes dans le salon.\r"
      ]
    },
    {
      "id": "ResortAreaRibbonSyndicate2F_Text_MuchMoreFriendly",
      "en_US": [
        "There.\n",
        "All done.\r",
        "Our treatment has made your pampered\n",
        "baby much more friendly to you."
      ],
      "fr_FR": [
        "Et voilà.\r",
        "L’amitié que vous porte votre Pokémon\n",
        "a beaucoup augmenté."
      ]
    },
    {
      "id": "ResortAreaRibbonSyndicate2F_Text_OneSessionADay",
      "en_US": [
        "Oh, I do apologize.\r",
        "We can only provide one spa\n",
        "session a day to our members."
      ],
      "fr_FR": [
        "Oh, je regrette.\r",
        "Nous ne pouvons offrir à nos membres \n",
        "qu’un seul soin relaxant par jour."
      ]
    },
    {
      "id": "ResortAreaRibbonSyndicate2F_Text_MoreFriendly",
      "en_US": [
        "There.\n",
        "All done.\r",
        "Our treatment has made your pampered\n",
        "baby more friendly to you."
      ],
      "fr_FR": [
        "Et voilà.\r",
        "L’amitié que vous porte votre Pokémon\n",
        "a augmenté."
      ]
    },
    {
      "id": "ResortAreaRibbonSyndicate2F_Text_LittleMoreFriendly",
      "en_US": [
        "There.\n",
        "All done.\r",
        "Our treatment has made your pampered\n",
        "baby a little more friendly to you."
      ],
      "fr_FR": [
        "Et voilà.\r",
        "L’amitié que vous porte votre Pokémon\n",
        "a un peu augmenté."
      ]
    },
    {
      "id": "ResortAreaRibbonSyndicate2F_Text_KeepFromSeeingOthers",
      "en_US": [
        "We keep our clients and Pokémon from\n",
        "seeing others.\r",
        "That way, all our clients and their\n",
        "Pokémon can fully relax."
      ],
      "fr_FR": [
        "Nos clients et leurs Pokémon jouissent \n",
        "ici d’une intimité totale.\r",
        "Comme ça, ils peuvent se \n",
        "détendre en toute tranquillité."
      ]
    },
    {
      "id": "ResortAreaRibbonSyndicate2F_Text_OnlyFiveMembersADay",
      "en_US": [
        "Our service is very exclusive.\n",
        "We only accept five members a day."
      ],
      "fr_FR": [
        "Notre service est très restreint. Nous \n",
        "n’acceptons que cinq membres par jour."
      ]
    },
    {
      "id": "ResortAreaRibbonSyndicate2F_Text_BringMembersCloser",
      "en_US": [
        "We’ve developed a reputation for\n",
        "bringing our members closer to\f",
        "their Pokémon."
      ],
      "fr_FR": [
        "Nous avons pour réputation de \n",
        "renforcer les liens qui unissent\f",
        "nos membres à leurs Pokémon."
      ]
    }
  ]
}