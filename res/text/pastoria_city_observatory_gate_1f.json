{
  "key": 13315,
  "messages": [
    {
      "id": "PastoriaCityObservatoryGate1F_Text_AskPlaySafariGame",
      "en_US": [
        "Welcome to the Great Marsh, the home\n",
        "of Pastoria’s Safari Game!\r",
        "All you can catch for just $500!\n",
        "Would you like to play a Safari Game?"
      ],
      "fr_FR": [
        "Bienvenue au Grand Marais!\n",
        "Il abrite le Jeu Safari de Verchamps!\r",
        "Attrapez-les tous pour 500 $!\n",
        "Voulez-vous participer au Jeu Safari?"
      ]
    },
    {
      "id": "PastoriaCityObservatoryGate1F_Text_ThatWillBe500",
      "en_US": "That will be $500, please.\r",
      "fr_FR": "Cela fera 500 $, s’il vous plaît.\r"
    },
    {
      "id": "PastoriaCityObservatoryGate1F_Text_HereAreSafariBalls",
      "en_US": "Here are your Safari Balls.\r",
      "fr_FR": "Voici vos Safari Balls.\r"
    },
    {
      "id": "PastoriaCityObservatoryGate1F_Text_PlayerReceived30SafariBalls",
      "en_US": [
        "{STRVAR_1 3, 0, 0} received\n",
        "30 Safari Balls.\r"
      ],
      "fr_FR": [
        "{STRVAR_1 3, 0, 0} reçoit\n",
        "30 Safari Balls.\r"
      ]
    },
    {
      "id": "PastoriaCityObservatoryGate1F_Text_OffYouGo",
      "en_US": [
        "We’ll let you know when your game\n",
        "is over.\r",
        "Until then, enjoy yourself, please!\n",
        "Off you go on your wild excursion!\r"
      ],
      "fr_FR": [
        "Nous vous préviendrons quand la partie\n",
        "sera finie.\r",
        "En attendant, amusez-vous bien!\n",
        "En avant pour une équipée sauvage!\r"
      ]
    },
    {
      "id": "PastoriaCityObservatoryGate1F_Text_PleaseComeAgain",
      "en_US": [
        "OK.\n",
        "Please come again!\r"
      ],
      "fr_FR": [
        "Très bien.\n",
        "Revenez vite!\r"
      ]
    },
    {
      "id": "PastoriaCityObservatoryGate1F_Text_NotEnoughMoney",
      "en_US": [
        "You don’t have enough money.\n",
        "Sorry.\r"
      ],
      "fr_FR": [
        "Quel dommage.\n",
        "Vous n’avez pas assez d’argent.\r"
      ]
    },
    {
      "id": "PastoriaCityObservatoryGate1F_Text_NoRoomForPokemon",
      "en_US": [
        "I’m sorry, you don’t have enough\n",
        "room to catch any more Pokémon.\r"
      ],
      "fr_FR": [
        "Toutes mes excuses, vous n’avez plus la\n",
        "place de capturer des Pokémon.\r"
      ]
    },
    {
      "id": "PastoriaCityObservatoryGate1F_Text_AskPlaySafariGameUnused",
      "en_US": [
        "Welcome to the Great Marsh, the home\n",
        "of Pastoria’s Safari Game!\r",
        "Recently, there have been sightings\n",
        "of Pokémon that are new to the area.\r",
        "Which brings us to...\r",
        "All you can catch for just $500!\n",
        "Would you like to play a Safari Game?"
      ],
      "fr_FR": [
        "Bienvenue au Grand Marais!\n",
        "Il abrite le Jeu Safari de Verchamps!\r",
        "Dernièrement, on a aperçu de\n",
        "nouveaux Pokémon dans le coin.\r",
        "Ça me fait penser...\r",
        "Attrapez-les tous pour 500 $!\n",
        "Voulez-vous participer au Jeu Safari?"
      ]
    },
    {
      "id": "PastoriaCityObservatoryGate1F_Text_AskExitGreatMarsh",
      "en_US": [
        "You still have time left. Are you sure\n",
        "you want to exit the Great Marsh?"
      ],
      "fr_FR": [
        "Il vous reste du temps. Voulez-vous\n",
        "vraiment quitter le Grand Marais?"
      ]
    },
    {
      "id": "PastoriaCityObservatoryGate1F_Text_ThanksForPlaying",
      "en_US": [
        "OK.\r",
        "I’ll relieve you of your remaining\n",
        "Safari Balls.\r",
        "Thank you for playing.\n",
        "We hope to see you again.\r"
      ],
      "fr_FR": [
        "Très bien.\r",
        "Je vous débarrasse des Safari Balls\n",
        "restantes.\r",
        "Merci d’avoir joué.\n",
        "Nous espérons vous revoir bientôt.\r"
      ]
    },
    {
      "id": "PastoriaCityObservatoryGate1F_Text_EnjoyWildAdventure",
      "en_US": [
        "Please enjoy the rest of your wild\n",
        "Safari Game adventure!\r"
      ],
      "fr_FR": [
        "Amusez-vous bien durant le reste de\n",
        "votre aventure au Jeu Safari!\r"
      ]
    },
    {
      "id": "PastoriaCityObservatoryGate1F_Text_IsThisFirstSafariGame",
      "en_US": [
        "Welcome to the Great Marsh!\n",
        "Is this your first Safari Game?"
      ],
      "fr_FR": [
        "Bienvenue au Grand Marais!\n",
        "C’est votre premier Jeu Safari?"
      ]
    },
    {
      "id": "PastoriaCityObservatoryGate1F_Text_ExplainSafariGame",
      "en_US": [
        "When you enter the Great Marsh, you\n",
        "start with 30 Safari Balls.\r",
        "That’s the only kind of Ball you’re\n",
        "allowed to use in the Safari Game.\r",
        "The game is over when you run out of\n",
        "Safari Balls, or when you’ve walked\f",
        "500 steps.\r",
        "Please do enjoy the untamed nature\n",
        "of the Great Marsh!"
      ],
      "fr_FR": [
        "En entrant dans le Grand Marais, vous\n",
        "commencez avec 30 Safari Balls.\r",
        "C’est le seul type de Ball que vous \n",
        "pouvez utiliser durant le Jeu Safari.\r",
        "La partie se termine lorsque vous êtes\n",
        "à court de Safari Balls ou que vous\f",
        "avez fait 500 pas.\r",
        "Profitez bien de la faune sauvage\n",
        "du Grand Marais!"
      ]
    },
    {
      "id": "PastoriaCityObservatoryGate1F_Text_EnjoySafariGame",
      "en_US": [
        "I see.\n",
        "Enjoy your Safari Game!"
      ],
      "fr_FR": [
        "Je vois.\n",
        "Amusez-vous bien au Jeu Safari!"
      ]
    },
    {
      "id": "PastoriaCityObservatoryGate1F_Text_CaptureFivePokemon",
      "en_US": [
        "Howdy.\n",
        "You’re playing the Safari Game?\r",
        "How would you like to try my game out\n",
        "at the same time?\r",
        "The rule--yep, there’s only one--is\n",
        "real simple.\r",
        "All you have to do is capture five or\n",
        "more Pokémon in one Safari Game.\r",
        "If you can do that, I’ll give you the\n",
        "Pokétch app Matchup Checker."
      ],
      "fr_FR": [
        "Bien le bonjour.\n",
        "Tu es en route pour un Jeu Safari?\r",
        "Ça te dirait de tester un jeu de mon cru\n",
        "pendant que t’y es?\r",
        "Il n’y a qu’une règle et elle est simple.\r",
        "Tout ce que tu as à faire, c’est\n",
        "capturer au moins cinq Pokémon\f",
        "au cours d’un Jeu Safari.\r",
        "Si tu y arrives, je te donnerai le\n",
        "logiciel Pokémontre Testeur d’Affinités."
      ]
    },
    {
      "id": "PastoriaCityObservatoryGate1F_Text_Dummy16",
      "garbage": 63
    },
    {
      "id": "PastoriaCityObservatoryGate1F_Text_Dummy17",
      "garbage": 117
    },
    {
      "id": "PastoriaCityObservatoryGate1F_Text_HereAppMatchupChecker",
      "en_US": [
        "So, how many Pokémon did you catch in\n",
        "your Safari Game? At least five?\r",
        "Ayup! You’ve done that all right!\n",
        "Isn’t that something!\r",
        "Well, here you are, then.\n",
        "The Pokétch app Matchup Checker.\r"
      ],
      "fr_FR": [
        "Combien de Pokémon as-tu attrapés\n",
        "pendant le Jeu Safari? Au moins cinq?\r",
        "Mais oui! Tu as réussi!\n",
        "Belle performance!\r",
        "Voilà pour toi. Comme promis, le logiciel\n",
        "Pokémontre Testeur d’Affinités.\r"
      ]
    },
    {
      "id": "PastoriaCityObservatoryGate1F_Text_ExplainMatchupChecker",
      "en_US": [
        "The Matchup Checker app figures out\n",
        "how Pokémon types match up.\r",
        "It won’t help tell us how we match up\n",
        "as friends, though."
      ],
      "fr_FR": [
        "Le Testeur d’Affinités évalue la\n",
        "compatibilité entre les types de\f",
        "Pokémon.\r",
        "Cependant il est incapable d’évaluer\n",
        "nos atomes crochus à nous."
      ]
    },
    {
      "id": "PastoriaCityObservatoryGate1F_Text_Dummy20",
      "garbage": 66
    }
  ]
}