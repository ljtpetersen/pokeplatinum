  "messages": [
    {
      "id": "SnowpointCityEastHouse_Text_HearTrendySaying",
      "en_US": [
        "Hello, hello. Would you like to hear\n",
        "a trendy saying?"
      ],
      "fr_FR": [
        "Bonjour, bonjour. Tu veux connaître\n",
        "une expression à la mode?"
      ]
    },
    {
      "id": "SnowpointCityEastHouse_Text_TrendyThingIsThis",
      "en_US": [
        "Very well...\r",
        "The trendy thing to say for you\n",
        "would be...\r",
        "{STRVAR_1 28, 0, 0}!\r",
        "That’s a trendy sort of thing\n",
        "to say."
      ],
      "fr_FR": [
        "Très bien...\r",
        "Pour toi, l’expression à la mode\n",
        "serait certainement...\r",
        "{STRVAR_1 28, 0, 0}!\r",
        "C’est trop fashion!"
      ]
    },
    {
      "id": "SnowpointCityEastHouse_Text_ComeOnNow",
      "en_US": [
        "Oh, come on now. With an attitude like\n",
        "that, you’ll fall behind the times!"
      ],
      "fr_FR": [
        "Oh, allez. Avec cette attitude, tu\n",
        "finiras complètement has-been!"
      ]
    },
    {
      "id": "SnowpointCityEastHouse_Text_UseTrendySayings",
      "en_US": [
        "I hope you’ll use trendy sayings\n",
        "in a trendy way."
      ],
      "fr_FR": [
        "Avec ces expressions à la mode, tu\n",
        "deviendras la coqueluche des paparazzi."
      ]
    },
    {
      "id": "SnowpointCityEastHouse_Text_AreYouUsingTrendySayings",
      "en_US": [
        "Hello, hello. Are you using trendy\n",
        "sayings?"
      ],
      "fr_FR": [
        "Bonjour, bonjour. Alors, tu les utilises\n",
        "mes expressions à la mode?"
      ]
    },
