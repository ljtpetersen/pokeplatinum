    {
      "id": "SnowpointCityEastHouse_Text_WantMeToTeachMove",
      "en_US": [
        "Share colored Shards with me, and I’ll\n",
        "teach your Pokémon some moves.\r",
        "Want me to teach a move?"
      ],
      "fr_FR": [
        "Je peux enseigner des capacités à tes\n",
        "Pokémon en échange de Tessons colorés.\r",
        "Alors, ça t’intéresse?"
      ]
    },
    {
      "id": "SnowpointCityEastHouse_Text_BeSeeingYou",
      "en_US": "Be seeing you, then!",
      "fr_FR": "Très bien. A la prochaine!"
    },
    {
