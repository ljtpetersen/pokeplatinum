  "messages": [
    {
      "id": "EternaCityHerbShop_Text_Welcome",
      "en_US": [
        "Welcome to the Herb Shop, home of\n",
        "effective yet inexpensive medicine."
      ],
      "fr_FR": [
        "Bienvenue à l’Herboristerie, de\n",
        "grands remèdes à petit prix."
      ]
    },
    {
      "id": "EternaCityHerbShop_Text_YourPokemonWontLikeThem",
      "en_US": [
        "Herbal meds work most impressively.\n",
        "But your Pokémon won’t like them.\f",
        "They’re horribly bitter and smelly!"
      ],
      "fr_FR": [
        "Les plantes médicinales, ça marche.\n",
        "Mais tes Pokémon n’aimeront pas ça.\f",
        "C’est amer et ça ne sent pas très bon!"
      ]
    },
    {
      "id": "EternaCityHerbShop_Text_InventNonBitterMedicine",
      "en_US": [
        "Someone ought to invent herbal\n",
        "medicine that isn’t bitter.\r",
        "That would be a medical breakthrough!"
      ],
      "fr_FR": [
        "Il faut que quelqu’un invente une\n",
        "herbe médicinale qui ne soit pas amère.\r",
        "Ça serait un grand pas en avant!"
      ]
    }
  ]
}