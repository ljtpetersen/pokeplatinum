    {
      "id": "VeilstoneStoreB1F_Text_ISellPoffins",
      "en_US": [
        "Hello!\n",
        "I sell Poffins.\r",
        "The ones I sell go for $6,400 each.\n",
        "Would you like one?"
      ],
      "fr_FR": [
        "Bonjour!\n",
        "J’ai des Poffins à vendre.\r",
        "C’est 6 400 $ pièce.\n",
