      "fr_FR": [
        "Ha, ha, ha! Je t’ai mis la main dessus!\n",
        "Je vais te prendre ton Drapeau!"
      ]
    },
    {
      "id": "EternaCityCondominiums3F_Text_ISetSomeTraps",
      "en_US": [
        "You can’t catch me!\n",
        "I set some Traps!"
