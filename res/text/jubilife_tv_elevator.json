    {
      "id": "JubilifeTVElevator_Text_Hello",
      "en_US": [
        "Hello, thank you for taking the time\n",
        "out of your busy day to visit us.\r",
        "To which floor may I take you?"
      ],
      "fr_FR": [
        "Bonjour, merci d’avoir pris le temps de\n",
        "venir nous rendre visite.\r",
        "A quel étage voulez-vous aller?"
      ]
    },
    {
      "id": "JubilifeTVElevator_Text_LookForward",
      "en_US": "I look forward to serving you again.",
      "fr_FR": "A une prochaine fois peut-être!"
