      "id": "TVReporterInterviews_Text_MayIDoQuickInterview",
      "en_US": [
        "Hello!\n",
        "I’m with Jubilife TV!\r",
        "May I hit you up for a quick\n",
        "interview?"
      ],
      "fr_FR": [
        "Bonjour!\n",
        "Je travaille pour Féli-Télé!\r",
        "Avez-vous du temps pour faire une\n",
        "interview rapide?"
