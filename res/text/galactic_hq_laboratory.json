  "messages": [
    {
      "id": "GalacticHQLaboratory_Text_ExperimentWentTooFar",
      "en_US": [
        "I feel awful about what we did...\n",
        "This experiment went too far...\r",
        "I’m not sure if I can stomach what\n",
        "Master Cyrus plans..."
      ],
      "fr_FR": [
        "J’ai honte de ce que nous avons fait...\n",
        "L’expérience est allée trop loin...\r",
        "Je ne suis pas sûr de pouvoir digérer ce\n",
        "qu’Hélio s’apprête à faire..."
      ]
    },
    {
      "id": "GalacticHQLaboratory_Text_IFeelTooSickened",
      "en_US": [
        "Urff...\n",
        "I feel too sickened to say anything...\r",
        "But that thing we made...\n",
        "What is it going to be used for?"
      ],
      "fr_FR": [
        "Beuuuh... Une horrible envie de vomir\n",
        "m’empêche de dire quoi que ce soit...\r",
        "Mais cette chose qu’on a fabriquée...\n",
        "A quoi va-t-elle servir?"
      ]
    },
    {
      "id": "GalacticHQLaboratory_Text_SomethingInGreenFluid",
      "en_US": [
        "There is something suspended in\n",
        "a green fluid..."
      ],
      "fr_FR": [
        "Quelque chose flotte en suspension\n",
        "dans un fluide verdâtre..."
      ]
    }
  ]
}