    {
      "id": "PalParkLobby_Text_PokemonThatJustEatsAndSleeps",
      "en_US": [
        "Let me see...\r",
        "A Pokémon that does nothing but\n",
        "eat and sleep.\r"
      ],
      "fr_FR": [
        "Voyons voir...\r",
        "Un Pokémon qui ne fait rien à part\n",
        "manger et dormir.\r"
      ]
    },
    {
      "id": "PalParkLobby_Text_ShowSnorlaxForApp",
      "en_US": [
        "Oh, a SNORLAX?\n",
        "It sure looks like it can eat!\r",
        "I have a Pokétch app that has\n",
        "a SNORLAX motif.\r",
        "You can have it for showing me\n",
        "a real SNORLAX!\r"
      ],
      "fr_FR": [
        "Oh, un RONFLEX?\n",
        "Il a l’air d’avoir un sacré estomac!\r",
        "J’ai un logiciel Pokémontre orné\n",
        "d’un motif RONFLEX.\r",
        "Je te le donne, puisque tu m’as montré\n",
        "un RONFLEX en chair et en os!\r"
      ]
    },
    {
      "id": "PalParkLobby_Text_KitchenTimerMakesYouCook",
      "en_US": [
        "Doesn’t that {STRVAR_1 24, 0, 0}\n",
        "make you want to cook something?\n"
      ],
      "fr_FR": [
        "Ce {STRVAR_1 24, 0, 0} ne te donne \n",
        "pas envie de cuisiner?"
      ]
    },
    {
      "id": "PalParkLobby_Text_PokemonThatChangesColor",
      "en_US": [
        "Let me see...\r",
        "A Pokémon that changes color\n",
        "whenever something happens.\r"
      ],
      "fr_FR": [
        "Voyons voir...\r",
        "Un Pokémon qui change de couleur\n",
        "dès que quelque chose se produit.\r"
      ]
    },
    {
      "id": "PalParkLobby_Text_ShowKecleonForApp",
      "en_US": [
        "Oh, a KECLEON!\n",
        "How colorful!\r",
        "I have a Pokétch app that features\n",
        "a KECLEON design.\r",
        "You can have it for showing me\n",
        "a real KECLEON!\r"
      ],
      "fr_FR": [
        "Oh, un KECLEON!\n",
        "Il est tellement coloré!\r",
        "J’ai un logiciel Pokémontre orné\n",
        "d’un motif KECLEON.\r",
        "Je te le donne, puisque tu m’as montré\n",
        "un KECLEON en chair et en os!\r"
      ]
    },
    {
      "id": "PalParkLobby_Text_ColorsChangeMood",
      "en_US": [
        "Changing colors can change your\n",
        "mood, too."
      ],
      "fr_FR": [
        "Changer de couleur peut également\n",
        "influencer ton humeur."
      ]
    },
