    {
      "id": "PalParkLobby_Text_Oak_ThisIsPalPark_PlayerMale",
      "en_US": [
        "Oak: Ah, {STRVAR_1 3, 0, 0}!\n",
        "This is it! This is Pal Park!\r"
      ],
      "fr_FR": [
        "Chen: Ah, {STRVAR_1 3, 0, 0}!\n",
        "Nous y voilà! C’est le Parc des Amis!\r"
      ]
    },
    {
      "id": "PalParkLobby_Text_Oak_ThisIsPalPark_PlayerFemale",
      "en_US": [
        "Oak: Ah, {STRVAR_1 3, 0, 0}!\n",
        "This is it! This is Pal Park!\r"
      ],
      "fr_FR": [
        "Chen: Ah, {STRVAR_1 3, 0, 0}!\n",
        "Nous y voilà! C’est le Parc des Amis!\r"
      ]
    },
    {
      "id": "PalParkLobby_Text_Oak_PokemonFromAroundTheCountry",
      "en_US": [
        "Pokémon from around the country\n",
        "can be brought here.\r",
        "In other words, Pokémon from\n",
        "places like Kanto and Hoenn.\r",
        "This place also happens to be where\n",
        "you compete to see how quickly you\f",
        "can catch those Pokémon!\r"
      ],
      "fr_FR": [
        "On peut apporter des Pokémon de tout\n",
        "le pays, ici.\r",
        "En d’autres termes, les Pokémon\n",
        "provenant de Kanto ou de Hoenn.\r",
        "Tu peux également concourir ici pour \n",
        "voir qui pourra attraper\f",
        "ces Pokémon en premier!\r"
      ]
    },
    {
      "id": "PalParkLobby_Text_Oak_GiftTrainerCounterApp",
      "en_US": [
        "It’s good to see you’ve come\n",
        "to join us for a visit.\r",
        "Let me make a gift of this Trainer\n",
        "Counter app for your Pokétch.\r"
      ],
      "fr_FR": [
        "Je suis ravi que tu viennes\n",
        "nous rendre visite.\r",
        "Laisse-moi t’offrir ce Compteur Poké\n",
        "Radar pour ta Pokémontre.\r"
      ]
    },
    {
      "id": "PalParkLobby_Text_Oak_InEternaForSomeTime",
      "en_US": [
        "Oak: I plan to be in Eterna City\n",
        "for some time.\r",
        "Being here, I should make the best\n",
        "of my time studying the Pokémon of\f",
        "the Sinnoh region.\r"
      ],
      "fr_FR": [
        "Chen: Je pense rester quelque temps\n",
        "à Vestigion.\r",
        "Je devrais vraiment en profiter pour \n",
        "étudier les Pokémon de Sinnoh.\r"
      ]
    },
    {
      "id": "PalParkLobby_Text_PalParkIsScintillating",
      "en_US": [
        "Pal Park is so scintillating!\r",
        "Trainers and Pokémon are so full of\n",
        "intensity here!\r"
      ],
      "fr_FR": [
        "Le Parc des Amis est vraiment féerique!\r",
        "Les Dresseurs et les Pokémon y sont\n",
        "pleins d’ardeur!\r"
      ]
    },
    {
      "id": "PalParkLobby_Text_NeverSeenPokemon",
      "en_US": [
        "I’ve never seen some Pokémon.\n",
        "Would you show me if you had one?\r"
      ],
      "fr_FR": [
        "Il y a certains Pokémon que je n’ai \n",
        "jamais vus. Tu pourrais me les montrer?\r"
      ]
    },
