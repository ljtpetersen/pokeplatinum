    {
      "id": "ScratchOffCards_Text_IntroduceScratchOffCards",
      "en_US": [
        "Welcome!\n",
        "Would you like some Scratch-Off Cards?\r",
        "You may buy three Scratch-Off Cards\n",
        "for {STRVAR_1 50, 0, 0} BP.\r",
        "Hidden on each Scratch-Off Card are\n",
        "icons of Pokémon.\r",
        "You may scratch the obscuring film off \n",
        "a card three times.\r",
        "If the same icon appears three times,\n",
        "you will win a prize, like a Berry.\r",
        "Also, DITTO’s icon can transform into\n",
        "any other Pokémon.\r",
        "Good luck matching Pokémon icons!\r"
      ],
      "fr_FR": [
        "Bienvenue!\n",
        "Voulez-vous des Cartes à gratter?\r",
        "Vous pouvez acheter un lot de trois\n",
        "Cartes à gratter pour {STRVAR_1 50, 0, 0} PCo.\r",
        "Des icônes représentant des Pokémon\n",
        "sont dissimulées sur chaque carte.\r",
        "Vous pouvez gratter trois cases\n",
        "sur chaque carte.\r",
        "Si vous révélez trois icônes identiques,\n",
        "vous remportez un prix, comme une Baie!\r",
        "Sachez qu’une icône METAMORPH peut se\n",
        "transformer en n’importe quel Pokémon!\r",
        "Bonne chance!\r"
      ]
    }
  ]
