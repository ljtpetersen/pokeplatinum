    {
      "id": "SandgemTownCounterpartHouse1F_Text_MassiveOutbreakOfPokemon",
      "en_US": [
        "Oh, hi, {STRVAR_1 3, 0, 0}!\r",
        "There was news on TV saying there\n",
        "is a massive outbreak of Pokémon!\r",
        "That’d be great for filling up your\n",
        "Pokédex!"
      ],
      "fr_FR": [
        "Oh, salut, {STRVAR_1 3, 0, 0}!\r",
        "Un bulletin d’information a annoncé\n",
        "une apparition massive de Pokémon!\r",
        "Ça va sûrement beaucoup t’aider pour\n",
        "compléter ton Pokédex!"
      ]
    },
    {
      "id": "SandgemTownCounterpartHouse1F_Text_BunchOfPokemonAtLocationMale",
      "en_US": [
        "Let me see...\n",
        "What did that news say now...?\r",
        "{STRVAR_1 4, 1, 0}! They said there’s\n",
        "a whole bunch of {STRVAR_1 0, 2, 0} there!\r",
        "{STRVAR_1 3, 0, 0}, you have to hurry!\r",
        "I want you to do better than my\n",
        "sister Dawn!"
      ],
      "fr_FR": [
        "Laisse-moi réfléchir...\n",
        "Que disait ce bulletin déjà...?\r",
        "{STRVAR_1 4, 1, 0}! Ils ont dit qu’il y\n",
        "avait plein de {STRVAR_1 0, 2, 0} là-bas!\r",
        "{STRVAR_1 3, 0, 0}, tu dois te dépêcher!\r",
        "Je veux que tu réussisses mieux que ma\n",
        "sœur Aurore!"
      ]
    },
