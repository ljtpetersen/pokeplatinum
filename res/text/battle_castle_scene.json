      ],
      "fr_FR": "Refuser le combat et passer un tour."
    },
    {
      "id": "BattleCastleScene_Text_ConfirmPurchase",
      "en_US": [
        "It will cost {STRVAR_1 52, 0, 0} CP.\n",
        "Is that acceptable?"
      ],
      "fr_FR": [
        "Cela vous coûtera {STRVAR_1 52, 0, 0} PCa.\n",
        "Cela vous paraît-il acceptable?"
      ]
