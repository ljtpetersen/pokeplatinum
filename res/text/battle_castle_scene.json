    {
      "id": "BattleCastleScene_Text_NotEnoughCP",
      "en_US": [
        "I’m terribly sorry.\n",
        "You have insufficient CP.\r"
      ],
      "fr_FR": [
        "Mille excuses, mais vous\n",
        "n’avez pas assez de PCa.\r"
      ]
    },
    {
      "id": "BattleCastleScene_Text_PassInstruction",
      "en_US": [
        "From here on, you may choose “Pass”\n",
        "and avoid battling a Trainer.\r",
        "If you don’t wish to battle a certain\n",
        "Trainer, choose “Pass.”\r"
      ],
      "fr_FR": [
        "Dorénavant, vous pourrez choisir\n",
        "“Passer un tour” si vous préférez\f",
        "éviter l’affrontement suivant.\r",
        "N’hésitez pas à utiliser cette option\n",
        "pour éviter un combat trop périlleux.\r"
      ]
    },
    {
      "id": "BattleCastleScene_Text_GiveCP",
      "en_US": [
        "Caitlin: ...\n",
        "Darach! CP for this Trainer at once!"
      ],
      "fr_FR": [
        "Percila: Bien... Parsley! Apportez des\n",
        "PCa. Immédiatement!"
      ]
    },
    {
      "id": "BattleCastleScene_Text_FantasticWin",
      "en_US": [
        "Darach: {STRVAR_1 3, 1, 0}, bravo.\n",
        "A fantastic victory, to be sure."
      ],
      "fr_FR": [
        "Parsley: Bravo, {STRVAR_1 3, 1, 0}.\n",
        "Quelle fabuleuse victoire!"
      ]
    },
    {
      "id": "BattleCastleScene_Text_RemarkableWin",
      "en_US": [
        "Darach: {STRVAR_1 3, 1, 0}, well done.\n",
        "A quite remarkable victory it was."
      ],
      "fr_FR": [
        "Parsley: Excellent, {STRVAR_1 3, 1, 0}. Ce\n",
        "combat était tout à fait remarquable."
      ]
    },
    {
      "id": "BattleCastleScene_Text_HardFoughtWin",
      "en_US": [
        "Darach: {STRVAR_1 3, 1, 0}, good show.\n",
        "A hard-fought win, yes?"
      ],
      "fr_FR": [
        "Parsley: Bon travail, {STRVAR_1 3, 1, 0}. Une\n",
        "victoire obtenue non sans mal, hm?"
      ]
    },
    {
      "id": "BattleCastleScene_Text_GoodEffort",
      "en_US": "Darach: {STRVAR_1 3, 1, 0}, good effort...",
      "fr_FR": [
        "Parsley: {STRVAR_1 3, 1, 0}, vos efforts\n",
        "sont louables..."
      ]
    },
    {
