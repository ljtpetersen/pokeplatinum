{
  "key": 47427,
  "messages": [
    {
      "id": "BattleCastleScene_Text_TakingItemsFirstTime",
      "en_US": [
        "Welcome to the Battle Castle.\n",
        "My name is Darach.\r",
        "I will be your host on behalf of Lady\n",
        "Caitlin, the owner of the castle.\r",
        "First, I must ask you for any items\n",
        "your Pokémon are holding.\r",
        "They will be returned to you when you\n",
        "leave.\r",
        "Next, I have here 10 Castle Points, CP,\n",
        "that can be used only here.\r",
        "They are for you.\n",
        "Please accept them.\r"
      ],
      "fr_FR": [
        "Bienvenue au Castel de Combat.\n",
        "Je m’appelle Parsley.\r",
        "Dame Percila, propriétaire de ce\n",
        "château, m’a chargé de vous guider.\r",
        "Avant tout, il me faut vous demander\n",
        "tous les objets tenus par vos Pokémon.\r",
        "Ils vous seront bien évidemment\n",
        "restitués à votre départ.\r",
        "Bien, permettez-moi également de vous\n",
        "remettre ces 10 Points Castel, ou PCa.\r",
        "Vous devrez les utiliser céans, car ils\n",
        "ne sont acceptés nulle part ailleurs.\r",
        "Tenez, les voici.\r"
      ]
    },
    {
      "id": "BattleCastleScene_Text_TakingItems",
      "en_US": [
        "Welcome.\r",
        "{STRVAR_1 3, 0, 0}, as per the rules, I must\n",
        "ask for your Pokémon’s held items.\r",
        "They will be returned to you when you\n",
        "leave.\r",
        "I also have for you 10 Castle Points,\n",
        "CP, that can only be used here.\r"
      ],
      "fr_FR": [
        "Bienvenue.\r",
        "{STRVAR_1 3, 0, 0}, il me faut vous demander\n",
        "tous les objets tenus par vos Pokémon.\r",
        "Le règlement est ainsi fait. Ceci dit, ils\n",
        "vous seront restitués ultérieurement.\r",
        "Je vous remets également 10 Points\n",
        "Castel, que vous devrez utiliser céans.\r"
      ]
    },
    {
      "id": "BattleCastleScene_Text_PleaseWait",
      "en_US": "Please wait a moment.",
      "fr_FR": "Veuillez patienter."
    },
    {
      "id": "BattleCastleScene_Text_Proceed",
      "en_US": [
        "Very well.\n",
        "Please proceed."
      ],
      "fr_FR": [
        "Parfait.\n",
        "Allons-y."
      ]
    },
    {
      "id": "BattleCastleScene_Text_RevivePokemon",
      "en_US": [
        "Your fainted Pokémon will be\n",
        "revived.\r"
      ],
      "fr_FR": "Tout Pokémon K.O. sera ranimé.\r"
    },
    {
      "id": "BattleCastleScene_Text_AreYouReady",
      "en_US": [
        "Upcoming is battle no. {STRVAR_1 53, 0, 0}.\n",
        "I trust you are ready?"
      ],
      "fr_FR": [
        "Le combat nº {STRVAR_1 53, 0, 0} vous attend. Votre\n",
        "détermination doit être sans faille!"
      ]
    },
    {
      "id": "BattleCastleScene_Text_SaveAsVideo",
      "en_US": [
        "Would you care to save the last battle\n",
        "as your Battle Video?"
      ],
      "fr_FR": [
        "Souhaitez-vous enregistrer la vidéo du\n",
        "dernier combat sur le Magnéto VS?"
      ]
    },
    {
      "id": "BattleCastleScene_Text_BattleSaved",
      "en_US": [
        "{STRVAR_1 3, 0, 0}’s battle has been saved\n",
        "as a Battle Video.\r"
      ],
      "fr_FR": [
        "La Vidéo de combat de {STRVAR_1 3, 0, 0}\n",
        "a été sauvegardée.\r"
      ]
    },
    {
      "id": "BattleCastleScene_Text_VideoSaveFailed",
      "en_US": [
        "There was an error.\n",
        "The Battle Video couldn’t be saved.\r"
      ],
      "fr_FR": [
        "Une erreur est survenue.\n",
        "La sauvegarde a échoué.\r"
      ]
    },
    {
      "id": "BattleCastleScene_Text_OverwriteVideo",
      "en_US": [
        "Would you care to delete your existing\n",
        "Battle Video and save the last battle?"
      ],
      "fr_FR": [
        "Voulez-vous effacer la Vidéo de combat\n",
        "précédente afin d’enregistrer celui-ci?"
      ]
    },
    {
      "id": "BattleCastleScene_Text_Saving",
      "en_US": [
        "Saving...\n",
        "Please do not turn the power off."
      ],
      "fr_FR": [
        "Sauvegarde en cours...\n",
        "Veuillez ne pas éteindre."
      ]
    },
    {
      "id": "BattleCastleScene_Text_BreakQuestion",
      "en_US": [
        "Would you like to save and take a break\n",
        "from playing?"
      ],
      "fr_FR": [
        "Voulez-vous sauvegarder et faire une\n",
        "pause?"
      ]
    },
