      ]
    },
    {
      "id": "BattleCastleScene_Text_GoodEffort2",
      "en_US": "Darach: {STRVAR_1 3, 1, 0}, good effort...\r",
      "fr_FR": [
        "Parsley: {STRVAR_1 3, 1, 0}, vos efforts\n",
        "sont louables...\r"
      ]
    },
    {
      "id": "BattleCastleScene_Text_CPEarned",
      "en_US": [
        "Lady Caitlin has instructed me to award\n",
        "you {STRVAR_1 51, 0, 0} CP."
      ],
      "fr_FR": [
        "Dame Percila m’a demandé de vous\n",
        "remettre {STRVAR_1 51, 0, 0} PCa en récompense."
      ]
    },
    {
      "id": "BattleCastleScene_Text_BPEarned",
      "en_US": [
        "Darach: Congratulations on clearing\n",
        "seven consecutive battles.\r",
        "For your valiant effort, {STRVAR_1 3, 0, 0},\n",
        "please accept this BP.\r"
      ],
      "fr_FR": [
        "Parsley: Félicitations! Vous avez\n",
        "remporté sept victoires successives.\r",
        "{STRVAR_1 3, 0, 0}, pour célébrer ceci,\n",
        "veuillez accepter ces PCo.\r"
      ]
    },
    {
      "id": "BattleCastleScene_Text_ReceiveBP",
      "en_US": "{STRVAR_1 3, 0, 0} received {STRVAR_1 51, 1, 0} BP!\r",
      "fr_FR": "{STRVAR_1 3, 0, 0} obtient {STRVAR_1 51, 1, 0} PCo!\r"
    },
    {
      "id": "BattleCastleScene_Text_ReturnItems",
      "en_US": [
        "We’ll return any items that we were\n",
        "holding for you.\r"
      ],
      "fr_FR": [
        "Voici l’ensemble des objets que\n",
        "nous conservions pour vous.\r"
      ]
    },
    {
      "id": "BattleCastleScene_Text_Saving2",
      "en_US": [
        "Saving...\n",
        "Don’t turn off the power."
      ],
      "fr_FR": [
        "Sauvegarde en cours...\n",
        "Ne pas éteindre."
      ]
    },
    {
      "id": "BattleCastleScene_Text_UsingPass",
      "en_US": [
        "Caitlin: ...Pass?\n",
        "...How uncouth!"
      ],
      "fr_FR": [
        "Percila: Vous passez un tour?\n",
        "Cela est peu délicat!"
      ]
    },
    {
      "id": "BattleCastleScene_Text_ContinueOption",
      "en_US": "CONTINUE",
      "fr_FR": "CONTINUER"
    },
    {
      "id": "BattleCastleScene_Text_RecordOption",
