    {
      "id": "VeilstoneStoreElevator_Text_FloorB1",
      "en_US": [
        "Basement floor: Food and produce, with\n",
        "many exclusives for you to enjoy.\n"
      ],
      "fr_FR": [
        "Niveau -1: Alimentation.\n",
        "Mets délicats introuvables ailleurs."
      ]
    }
