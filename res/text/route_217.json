{
  "key": 39556,
  "messages": [
    {
      "id": "Route217_Text_OhPlayer",
      "en_US": "Maylene: Oh, {STRVAR_1 3, 0, 0}!\r",
      "fr_FR": "Mélina: Oh, {STRVAR_1 3, 0, 0}!\r"
    },
    {
      "id": "Route217_Text_GoingToSnowpointCity",
      "en_US": [
        "Um, are you maybe on your way to\n",
        "Snowpoint City?\r",
        "That’s where I’m going, too.\r",
        "If I use Fly, I can get there instantly,\n",
        "but I’m walking for my training.\r",
        "I have no problem with this.\r",
        "I’m used to the cold because I go\n",
        "barefoot and lightly dressed.\r",
        "...Achoo!\r",
        "Oh, that was nothing.\n",
        "Really, I’m not cold at all.\r",
        "I’ll be going now.\n",
        "Please take care!\r"
      ],
      "fr_FR": [
        "Tu es en route pour Frimapic?\n",
        "Moi aussi.\r",
        "Avec la capacité Vol, je pourrais y être\n",
        "instantanément, mais la marche fait\f",
        "partie de mon entraînement.\r",
        "Ça ne me dérange pas.\r",
        "Je suis habituée au froid et à déambuler\n",
        "pieds nus et légèrement vêtue.\r",
        "Atchoum!\r",
        "Oh, ce n’est rien. Ne va pas croire\n",
        "que j’ai froid.\r",
        "Je dois y aller.\n",
        "Bonne chance!\r"
      ]
    },
    {
      "id": "Route217_Text_ImUsingDowsingMachine",
      "en_US": [
        "I’m using the Dowsing Machine on\n",
        "my Pokétch.\r",
        "I’m looking for things buried under\n",
        "the snow."
      ],
      "fr_FR": [
        "J’utilise le Radar à Objet de\n",
        "ma Pokémontre.\r",
        "Je cherche des choses enfouies\n",
        "sous la neige."
      ]
    },
    {
      "id": "Route217_Text_BoulderEncrustedWithIce",
      "en_US": [
        "The boulder is encrusted with ice.\n",
        "It is bone chilling to touch."
      ],
      "fr_FR": [
        "Le rocher est enveloppé de glace.\n",
        "Il est glacial au toucher."
      ]
    },
    {
      "id": "Route217_Text_SignLakeAcuity",
      "en_US": [
        "Rt. 217\n",
        "Lake Acuity"
      ],
      "fr_FR": [
        "Route 217\n",
        "Lac Savoir"
      ]
    }
  ]
}