      "id": "CanalaveCityHarborInn_Text_ReservationForYou",
      "en_US": [
        "...Welcome...\r",
        "...\n",
        "...Kekeke...\r",
        "We’ve had a reservation for you.\n",
        "We’ve held it a long time...\r"
      ],
      "fr_FR": [
        "... Bienvenue...\r",
        "...\n",
        "... Nyihihi...\r",
        "Nous avons une réservation à ton nom.\n",
        "Nous t’attendons depuis longtemps...\r"
      ]
    },
    {
      "id": "CanalaveCityHarborInn_Text_PlayerLayDown",
      "en_US": [
        "{STRVAR_1 3, 0, 0} lay down on the bed as if\n",
