    {
      "id": "pl_msg_00000210_00046",
      "en_US": [
        "Enables the user to\n",
        "perform first in the\n",
        "next turn."
      ],
      "fr_FR": [
        "Permet au lanceur de\n",
        "passer en premier au\n",
        "tour suivant."
      ]
    },
    {
      "id": "pl_msg_00000210_00047",
      "en_US": [
        "Enables the user to\n",
        "perform last in the\n",
        "next turn."
      ],
      "fr_FR": [
        "Permet au lanceur de\n",
        "passer en dernier au\n",
        "tour suivant."
      ]
    },
    {
      "id": "pl_msg_00000210_00048",
      "en_US": [
        "Earn +2 for each\n",
        "time the same Judge\n",
        "is chosen."
      ],
      "fr_FR": [
        "Fait gagner +2 chaque\n",
        "fois que le même Juge\n",
        "est choisi."
      ]
    },
    {
      "id": "pl_msg_00000210_00049",
      "en_US": [
        "Earn +2 if the\n",
        "Judge’s Voltage goes\n",
        "up."
      ],
      "fr_FR": [
        "Fait gagner +2 si le\n",
        "Voltage du Juge\n",
        "augmente."
      ]
    },
    {
      "id": "pl_msg_00000210_00050",
      "en_US": [
        "A basic performance\n",
        "using a move known\n",
        "by the Pokémon."
      ],
      "fr_FR": [
        "Action basique d’une\n",
        "capacité connue\n",
        "du Pokémon."
      ]
    },
    {
      "id": "pl_msg_00000210_00051",
      "en_US": [
        "Earn +3 if no other\n",
        "Pokémon has chosen\n",
        "the same Judge."
      ],
      "fr_FR": [
        "Gagne +3 si aucun\n",
        "autre Pokémon n’a\n",
        "choisi le même Juge."
      ]
    },
    {
      "id": "pl_msg_00000210_00052",
      "en_US": [
        "Allows performance\n",
        "of the same move\n",
        "twice in a row."
      ],
      "fr_FR": [
        "Cette capacité peut\n",
        "être utilisée deux\n",
        "fois de suite."
      ]
    },
    {
      "id": "pl_msg_00000210_00053",
      "en_US": [
        "Increased Voltage is\n",
        "added to the\n",
        "performance score."
      ],
      "fr_FR": [
        "Des points Voltage\n",
        "s’ajoutent au score\n",
        "de la capacité."
      ]
    },
    {
      "id": "pl_msg_00000210_00054",
      "en_US": [
        "Earn +15 if all the\n",
        "Pokémon choose the\n",
        "same Judge."
      ],
      "fr_FR": [
        "Fait gagner +15 si les\n",
        "Pokémon choisissent\n",
        "tous le même Juge."
      ]
    },
    {
      "id": "pl_msg_00000210_00055",
      "en_US": [
        "Lowers the Voltage\n",
        "of all Judges by one\n",
        "each."
      ],
      "fr_FR": [
        "Baisse le Voltage de\n",
        "tous les Juges de un."
      ]
    },
    {
      "id": "pl_msg_00000210_00056",
      "en_US": [
        "Earn double the\n",
        "score in the next\n",
        "turn."
      ],
      "fr_FR": [
        "Fait gagner le double\n",
        "de points au tour\n",
        "suivant."
      ]
    },
    {
      "id": "pl_msg_00000210_00057",
      "en_US": [
        "Steals the Voltage\n",
        "of the Pokémon that\n",
        "just went."
      ],
      "fr_FR": [
        "Permet de voler le\n",
        "Voltage du Pokémon\n",
        "qui vient de passer."
      ]
    },
    {
      "id": "pl_msg_00000210_00058",
      "en_US": [
        "Prevents the Voltage\n",
        "from going up in the\n",
        "same turn."
      ],
      "fr_FR": [
        "Empêche le Voltage\n",
        "d’augmenter dans le\n",
        "même tour."
      ]
    },
    {
      "id": "pl_msg_00000210_00059",
      "en_US": [
        "Makes the order of\n",
        "contestants random\n",
        "in the next turn."
      ],
      "fr_FR": [
        "Rend le passage des\n",
        "concurrents aléatoire\n",
        "au tour suivant."
      ]
    },
    {
      "id": "pl_msg_00000210_00060",
      "en_US": [
        "Earns double the\n",
        "score on the final\n",
        "performance."
      ],
      "fr_FR": [
        "Score doublé si\n",
        "passe en dernier."
      ]
    },
    {
      "id": "pl_msg_00000210_00061",
      "en_US": [
        "Raises the score if\n",
        "the Voltage is low."
      ],
      "fr_FR": [
        "Augmente le score si\n",
        "le Voltage est bas."
      ]
    },
    {
      "id": "pl_msg_00000210_00062",
      "en_US": [
        "Earn +2 if the\n",
        "Pokémon performs\n",
        "first in the turn."
      ],
      "fr_FR": [
        "+2 si le Pokémon\n",
        "passe en 1¹\n",
        "dans ce tour."
      ]
    },
    {
      "id": "pl_msg_00000210_00063",
      "en_US": [
        "Earn +2 if the\n",
        "Pokémon performs\n",
        "last in the turn."
      ],
      "fr_FR": [
        "+2 si le Pokémon\n",
        "passe en dernier\n",
        "dans ce tour."
      ]
    },
    {
      "id": "pl_msg_00000210_00064",
      "en_US": [
        "Prevents the Voltage\n",
        "from going down in\n",
        "the same turn."
      ],
      "fr_FR": [
        "Empêche le Voltage de\n",
        "baisser pendant le\n",
        "tour."
      ]
    },
    {
      "id": "pl_msg_00000210_00065",
      "en_US": [
        "Earn +3 if two\n",
        "Pokémon raise the\n",
        "Voltage in a row."
      ],
      "fr_FR": [
        "+3 si deux Pokémon\n",
        "font monter le\n",
        "Voltage à la suite."
      ]
    },
    {
      "id": "pl_msg_00000210_00066",
      "en_US": [
        "Earn a higher score\n",
        "the later the\n",
        "Pokémon performs."
      ],
      "fr_FR": [
        "Plus le Pokémon\n",
        "passe tard, plus\n",
        "le score est élevé."
      ]
    },
    {
      "id": "pl_msg_00000210_00067",
      "en_US": [
        "Earn +3 if the\n",
        "Pokémon that just\n",
        "went hit max Voltage."
      ],
      "fr_FR": [
        "Fait gagner +3 si le\n",
        "Pokémon précédent\n",
        "a obtenu Voltage max."
      ]
    },
    {
      "id": "pl_msg_00000210_00068",
      "en_US": [
        "Earn +3 if the\n",
        "Pokémon gets the\n",
        "lowest score."
      ],
      "fr_FR": [
        "Fait gagner +3 si le\n",
        "Pokémon a le score\n",
        "le plus bas."
      ]
    }
  ]
}